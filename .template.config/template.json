{
  "$schema": "http://json.schemastore.org/template",
  "author": "opx",
  "classifications": ["Web", "Blazor", "MudBlazor", "OPX"],
  "identity": "Opx.MudBlazor.FlatUi.Web.Template.2.0.8.Responsive1",
  "name": "OPX MudBlazor Flat UI Web",
  "shortName": "opx-flatui-web",
  "sourceName": "Opx.MudBlazor.FlatUi.Sample",
  "defaultName": "Opx.FlatUi.App",
  "preferNameDirectory": true,
  "description": "Creates an OPX Flat UI Blazor Web app pinned to the verified 2.0.8 consumer contract, including adaptive responsive rules, clean initial run, package-owned reusable CSS, runtime OPX attribution, Settings, the default sidebar, and canonical widget spacing.",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sources": [
    {
      "source": "samples/Opx.MudBlazor.FlatUi.Sample",
      "target": "./",
      "exclude": ["**/bin/**", "**/obj/**", ".vs/**", "wwwroot/lib/bootstrap/**"]
    },
    {
      "source": ".agents",
      "target": ".agents"
    },
    {
      "source": ".",
      "target": "./",
      "include": ["RULES.md", "NuGet.Config", "Directory.Build.props", ".gitignore"]
    },
    {
      "source": "docs",
      "target": "docs",
      "include": ["CONSUMER-CONTRACT.md", "WIDGETS.md"]
    }
  ],
  "primaryOutputs": [
    {
      "path": "Opx.MudBlazor.FlatUi.Sample.csproj"
    }
  ]
}
