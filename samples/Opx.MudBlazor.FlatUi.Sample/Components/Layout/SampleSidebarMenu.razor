        @if (ShowItem("Dynamic Menu", "Operations", "Autoload")) { <MudNavLink Href="/dynamic-menu" Icon="@Icons.Material.Outlined.AccountTree">Dynamic Menu</MudNavLink> }
        @if (ShowItem("Operations Workspace", "Operations", "Service Desk", "Approval")) { <MudNavLink Href="/operations-workspace" Icon="@Icons.Material.Outlined.Workspaces">Operations Workspace</MudNavLink> }
        @if (ShowItem("Spatial Operations", "Operations", "Map", "Geofence", "Route Playback")) { <MudNavLink Href="/spatial-operations" Icon="@Icons.Material.Outlined.Explore">Spatial Operations</MudNavLink> }
        @if (ShowItem("Tree Grid", "Operations")) { <MudNavLink Href="/tree-grid" Icon="@Icons.Material.Outlined.AccountTree">Tree Grid</MudNavLink> }
        @if (ShowItem("Jobs", "Operations", "Job Board")) { <MudNavLink Href="/jobs" Icon="@Icons.Material.Outlined.WorkHistory">Jobs</MudNavLink> }
        @if (ShowItem("Kanban", "Operations")) { <MudNavLink Href="/kanban" Icon="@Icons.Material.Outlined.ViewKanban">Kanban</MudNavLink> }
        @if (ShowItem("Calendar", "Operations", "Schedule")) { <MudNavLink Href="/calendar" Icon="@Icons.Material.Outlined.CalendarMonth">Calendar</MudNavLink> }
        @if (ShowItem("Sales Pipeline", "Operations")) { <MudNavLink Href="/sales-pipeline" Icon="@Icons.Material.Outlined.FilterAlt">Sales Pipeline</MudNavLink> }
        @if (ShowItem("Chat", "Operations")) { <MudNavLink Href="/chat" Icon="@Icons.Material.Outlined.Chat">Chat</MudNavLink> }
        @if (ShowItem("AI Chat", "Operations", "Assistant")) { <MudNavLink Href="/ai-chat" Icon="@Icons.Material.Outlined.AutoAwesome">AI Chat</MudNavLink> }
        @if (ShowItem("Email", "Operations"))
        {
            <MudNavLink Href="/email" Icon="@Icons.Material.Outlined.MailOutline">
                Email
                <FlatNavigationBadge Text="3" Color="@Color.Error" AccessibleLabel="3 unread messages" />
            </MudNavLink>
        }
        @if (ShowItem("Monitoring Service", "Operations")) { <MudNavLink Href="/monitoring" Icon="@Icons.Material.Outlined.MonitorHeart">Monitoring Service</MudNavLink> }
        @if (ShowItem("Monitoring Database", "Operations")) { <MudNavLink Href="/monitoring-database" Icon="@Icons.Material.Outlined.Dns">Monitoring Database</MudNavLink> }
        </ChildContent>
    </MudNavGroup>
}

