{
    <MudNavGroup Title="UI Kit"
                 Icon="@Icons.Material.Outlined.Widgets"
                 Expanded="@ExpandGroup(_uiKitExpanded)"
                 ExpandedChanged="@((bool value) => _uiKitExpanded = value)"
                 Class="sample-menu-tree">
        @if (ShowItem("Components", "UI Kit")) { <MudNavLink Href="/components" Icon="@Icons.Material.Outlined.Widgets">Components</MudNavLink> }
        @if (ShowItem("Development Rules", "UI Kit")) { <MudNavLink Href="/development-rules" Icon="@Icons.Material.Outlined.Rule">Development Rules</MudNavLink> }
