        @if (ShowItem("Reports", "Data & Reports")) { <MudNavLink Href="/reports" Icon="@Icons.Material.Outlined.Assessment">Reports</MudNavLink> }
        @if (ShowItem("Pivot", "Data & Reports")) { <MudNavLink Href="/pivot" Icon="@Icons.Material.Outlined.PivotTableChart">Pivot</MudNavLink> }
