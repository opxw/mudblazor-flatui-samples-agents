@implements IDisposable
@inject NavigationManager Navigation

@using Opx.MudBlazor.FlatUi.Models

<MudText Class="nav-caption">Showcase</MudText>
@if (ShowItem("Dashboard"))
{
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">
        Dashboard
        <FlatNavigationBadge Text="New" AccessibleLabel="New dashboard" />
    </MudNavLink>
}

@if (ShowGroup(ErpTerms))
{
    <MudNavGroup Title="ERP"
                 Icon="@Icons.Material.Outlined.Business"
                 Expanded="@ExpandGroup(_erpExpanded)"
                 ExpandedChanged="@((bool value) => _erpExpanded = value)"
                 Class="sample-menu-tree erp-menu-root">
        <TitleContent>
            <span>ERP</span>
            <FlatNavigationBadge Text="6" Color="@Color.Secondary" AccessibleLabel="6 ERP modules" />
        </TitleContent>
        <ChildContent>
        @if (ShowItem("ERP Overview", "ERP")) { <MudNavLink Href="/erp" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.SpaceDashboard">ERP Overview</MudNavLink> }
        @if (ShowItem("ERP Toolkit", "ERP", "Transaction", "Reconciliation", "Planning")) { <MudNavLink Href="/erp-toolkit" Icon="@Icons.Material.Outlined.AccountTree">ERP Toolkit</MudNavLink> }
        @if (ShowGroup(HrTerms))
        {
            <MudNavGroup Title="Human Resources" Icon="@Icons.Material.Outlined.Groups" Expanded="@ExpandGroup(_erpHrExpanded)" ExpandedChanged="@((bool value) => _erpHrExpanded = value)" Class="sample-menu-tree erp-menu-subgroup">
                @if (ShowItem("HR Overview", "Human Resources", "ERP")) { <MudNavLink Href="/erp/hr" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">HR Overview</MudNavLink> }
                @if (ShowItem("Employees", "Human Resources", "ERP")) { <MudNavLink Href="/erp/hr/employees" Icon="@Icons.Material.Outlined.Badge">Employees</MudNavLink> }
                @if (ShowItem("Attendance & Leave", "Human Resources", "ERP")) { <MudNavLink Href="/erp/hr/attendance" Icon="@Icons.Material.Outlined.EventAvailable">Attendance & Leave</MudNavLink> }
            </MudNavGroup>
        }
        @if (ShowGroup(ProductionTerms))
        {
            <MudNavGroup Title="Production" Icon="@Icons.Material.Outlined.Factory" Expanded="@ExpandGroup(_erpProductionExpanded)" ExpandedChanged="@((bool value) => _erpProductionExpanded = value)" Class="sample-menu-tree erp-menu-subgroup">
                @if (ShowItem("Production Plan", "Production", "ERP")) { <MudNavLink Href="/erp/production" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Analytics">Production Plan</MudNavLink> }
                @if (ShowItem("Work Orders", "Production", "ERP")) { <MudNavLink Href="/erp/production/work-orders" Icon="@Icons.Material.Outlined.PrecisionManufacturing">Work Orders</MudNavLink> }
                @if (ShowItem("Quality Control", "Production", "ERP")) { <MudNavLink Href="/erp/production/quality" Icon="@Icons.Material.Outlined.FactCheck">Quality Control</MudNavLink> }
            </MudNavGroup>
        }
        @if (ShowGroup(FinanceTerms))
        {
            <MudNavGroup Title="Finance" Icon="@Icons.Material.Outlined.AccountBalance" Expanded="@ExpandGroup(_erpFinanceExpanded)" ExpandedChanged="@((bool value) => _erpFinanceExpanded = value)" Class="sample-menu-tree erp-menu-subgroup">
                @if (ShowItem("Finance Overview", "Finance", "ERP")) { <MudNavLink Href="/erp/finance" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.Dashboard">Finance Overview</MudNavLink> }
                @if (ShowItem("General Ledger", "Finance", "ERP")) { <MudNavLink Href="/erp/finance/general-ledger" Icon="@Icons.Material.Outlined.MenuBook">General Ledger</MudNavLink> }
                @if (ShowItem("Accounts Payable", "Finance", "ERP")) { <MudNavLink Href="/erp/finance/payables" Icon="@Icons.Material.Outlined.Payments">Accounts Payable</MudNavLink> }
                @if (ShowItem("Accounts Receivable", "Finance", "ERP")) { <MudNavLink Href="/erp/finance/receivables" Icon="@Icons.Material.Outlined.RequestQuote">Accounts Receivable</MudNavLink> }
            </MudNavGroup>
        }
        @if (ShowGroup(SupplyChainTerms))
        {
            <MudNavGroup Title="Supply Chain" Icon="@Icons.Material.Outlined.LocalShipping" Expanded="@ExpandGroup(_erpSupplyChainExpanded)" ExpandedChanged="@((bool value) => _erpSupplyChainExpanded = value)" Class="sample-menu-tree erp-menu-subgroup">
                @if (ShowItem("Procurement", "Supply Chain", "ERP")) { <MudNavLink Href="/erp/procurement" Icon="@Icons.Material.Outlined.ShoppingCart">Procurement</MudNavLink> }
                @if (ShowItem("Inventory", "Supply Chain", "ERP")) { <MudNavLink Href="/erp/inventory" Icon="@Icons.Material.Outlined.Inventory2">Inventory</MudNavLink> }
            </MudNavGroup>
        }
        @if (ShowGroup(SalesTerms))
        {
            <MudNavGroup Title="Sales & Distribution" Icon="@Icons.Material.Outlined.PointOfSale" Expanded="@ExpandGroup(_erpSalesExpanded)" ExpandedChanged="@((bool value) => _erpSalesExpanded = value)" Class="sample-menu-tree erp-menu-subgroup">
                @if (ShowItem("Sales Overview", "Sales & Distribution", "ERP")) { <MudNavLink Href="/erp/sales" Match="NavLinkMatch.All" Icon="@Icons.Material.Outlined.ShowChart">Sales Overview</MudNavLink> }
                @if (ShowItem("Sales Orders", "Sales & Distribution", "ERP")) { <MudNavLink Href="/erp/sales/orders" Icon="@Icons.Material.Outlined.ReceiptLong">Sales Orders</MudNavLink> }
            </MudNavGroup>
        }
        </ChildContent>
    </MudNavGroup>
}

