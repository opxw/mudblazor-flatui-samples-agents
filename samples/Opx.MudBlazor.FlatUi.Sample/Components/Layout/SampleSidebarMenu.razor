        @if (ShowItem("Business Toolkit", "Data & Reports", "Traceability", "BOM", "Rules", "Approval")) { <MudNavLink Href="/business-toolkit" Icon="@Icons.Material.Outlined.AccountTree">Business Toolkit</MudNavLink> }
        @if (ShowItem("ERP Release Train", "Data & Reports", "Transaction", "Inventory", "Finance", "Workflow", "MRP")) { <MudNavLink Href="/erp-release-train" Icon="@Icons.Material.Outlined.Factory">ERP Release Train</MudNavLink> }
        @if (ShowItem("Advanced Editable Grid", "Data & Reports", "Grid", "Spreadsheet", "Add", "Edit")) { <MudNavLink Href="/advanced-editable-grid" Icon="@Icons.Material.Outlined.TableView">Advanced Editable Grid</MudNavLink> }
