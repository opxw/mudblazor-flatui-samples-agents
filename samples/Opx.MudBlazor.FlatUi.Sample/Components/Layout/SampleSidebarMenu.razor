@if (HasSearch && !HasMenuResult)
{
    <div class="sidebar-search-empty">
        <MudIcon Icon="@Icons.Material.Outlined.SearchOff" />
        <span>No menu found</span>
    </div>
}

@code {
    private static readonly string[] OperationsTerms =
        ["Operations", "CRUD Asset", "CRUD Simple", "Grid Editor", "Inline Edit", "Model CRUD", "Generated Form", "Data Annotations", "Form Designer", "WYSIWYG", "Live Preview", "Padding", "Margin", "CSS Class", "Dynamic Menu", "Autoload", "MenuText", "ParentId", "Operations Workspace", "Spatial Operations", "Map", "Geofence", "Route Playback", "Fleet", "Service Desk", "Approval", "Procurement", "Stock Transfer", "Timesheet", "POS", "Tree Grid", "Hierarchy", "Parent Key", "Drag Drop", "Jobs", "Job Board", "Kanban", "Task Board", "Workflow", "Calendar", "Schedule", "Agenda", "Sales Pipeline", "CRM", "Deals", "Chat", "AI Chat", "Assistant", "Prompt", "Messages", "Conversation", "Email", "Mailbox", "Inbox", "Compose", "Monitoring Service", "Monitoring Database"];
    private static readonly string[] DataTerms = ["Data & Reports", "Static / Master", "Large Data Grid", "Table", "Scroll", "Reports", "Pivot", "Matrix", "Aggregate", "Enterprise Toolkit", "Experience Toolkit", "Accessibility", "Command Palette", "Schema Form", "Collaboration", "Conflict", "Import", "Master Detail", "Audit", "Workflow", "Scheduler", "Offline Sync", "Documents"];
    private static readonly string[] CommerceTerms = ["Commerce & Content", "Product Catalog", "Product Management", "Product Detail", "Product Editor", "Catalog", "Ecommerce", "Products", "Filters", "Gallery", "Publish", "Tags", "Website Front", "Job Landing", "Careers", "Recruitment", "Blog", "Landing Page", "Front Page"];
    private static readonly string[] AccountTerms = ["Account", "Edit Account", "User Profile", "Login Sample", "Two-step Verification", "2FA", "OTP", "Reset Password", "Forgot Password", "Recovery"];
    private static readonly string[] UiKitTerms = ["UI Kit", "Components", "Development Rules", "Rules", "Skill", "Source of Truth", "PageId", "Accordions", "Accordion", "Collapse", "Expand", "Flush", "Charts", "MudBlazor Charts", "Line", "Bar", "Stacked Bar", "Pie", "Donut", "Timeseries", "Heat Map", "Rose", "Radar", "Sankey", "Scatter Plot", "File Upload", "Drag Drop", "Progress", "Grid Preferences", "Saved Views", "Virtualization", "Vector Map", "Floor Plan", "Denah", "Location", "Tracking", "GPS", "Route", "Waypoint", "Colors", "Palette", "Semantic", "Timeline", "Activity", "Widgets", "Metric", "Profile Card Grid", "Members", "Card Grid"];
    private static readonly string[] HrTerms = ["Human Resources", "HR Overview", "Employees", "Attendance & Leave"];
    private static readonly string[] ProductionTerms = ["Production", "Production Plan", "Work Orders", "Quality Control"];
    private static readonly string[] FinanceTerms = ["Finance", "Finance Overview", "General Ledger", "Accounts Payable", "Accounts Receivable"];
    private static readonly string[] SupplyChainTerms = ["Supply Chain", "Procurement", "Inventory"];
    private static readonly string[] SalesTerms = ["Sales & Distribution", "Sales Overview", "Sales Orders"];
    private static readonly string[] ErpTerms = ["ERP", "ERP Overview", .. HrTerms, .. ProductionTerms, .. FinanceTerms, .. SupplyChainTerms, .. SalesTerms];
    private static readonly string[] AllMenuTerms =
        ["Dashboard", .. ErpTerms, .. OperationsTerms, .. DataTerms, .. CommerceTerms, .. AccountTerms, .. UiKitTerms];

    private bool _operationsExpanded;
    private bool _dataExpanded;
    private bool _commerceExpanded;
    private bool _accountExpanded;
    private bool _uiKitExpanded;
    private bool _erpExpanded;
    private bool _erpHrExpanded;
    private bool _erpProductionExpanded;
    private bool _erpFinanceExpanded;
    private bool _erpSupplyChainExpanded;
    private bool _erpSalesExpanded;

    [CascadingParameter] public FlatSidebarSearchState? SearchState { get; set; }

    private bool HasSearch => SearchState?.HasSearch == true;
    private bool HasMenuResult => AllMenuTerms.Any(SearchMatches);
    private bool ExpandGroup(bool currentValue) => HasSearch || currentValue;
    private bool SearchMatches(string value) => SearchState?.Matches(value) == true;
    private bool ShowGroup(IEnumerable<string> terms) => !HasSearch || terms.Any(SearchMatches);
    private bool ShowItem(string text, params string[] parents) =>
        !HasSearch || SearchMatches(text) || parents.Any(SearchMatches);

    protected override void OnInitialized()
    {
        ExpandActiveRouteGroup();
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args) =>
        _ = InvokeAsync(() =>
        {
            ExpandActiveRouteGroup();
            StateHasChanged();
        });

    private void ExpandActiveRouteGroup()
    {
        var path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        if (path.StartsWith("/erp", StringComparison.OrdinalIgnoreCase))
        {
            _erpExpanded = true;
            _erpHrExpanded = path.StartsWith("/erp/hr", StringComparison.OrdinalIgnoreCase);
            _erpProductionExpanded = path.StartsWith("/erp/production", StringComparison.OrdinalIgnoreCase);
            _erpFinanceExpanded = path.StartsWith("/erp/finance", StringComparison.OrdinalIgnoreCase);
            _erpSupplyChainExpanded = path.StartsWith("/erp/procurement", StringComparison.OrdinalIgnoreCase)
                || path.StartsWith("/erp/inventory", StringComparison.OrdinalIgnoreCase);
            _erpSalesExpanded = path.StartsWith("/erp/sales", StringComparison.OrdinalIgnoreCase);
            return;
        }

        switch (path.ToLowerInvariant())
        {
            case "/crud":
            case "/crud-simple":
            case "/grid-editor":
            case "/model-crud":
            case "/model-form-designer":
            case "/dynamic-menu":
            case "/operations-workspace":
            case "/spatial-operations":
            case "/jobs":
            case "/kanban":
            case "/calendar":
            case "/sales-pipeline":
            case "/chat":
            case "/email":
            case "/monitoring":
            case "/monitoring-database":
                _operationsExpanded = true;
                break;
            case "/static-data":
            case "/data-grid-large":
            case "/reports":
            case "/pivot":
            case "/enterprise-toolkit":
            case "/experience-toolkit":
                _dataExpanded = true;
                break;
            case "/catalog":
            case "/job-landing":
            case "/website":
            case "/blog":
                _commerceExpanded = true;
                break;
            case "/account/edit":
            case "/login":
            case "/two-step-verification":
            case "/reset-password":
                _accountExpanded = true;
                break;
            case "/components":
            case "/accordions":
            case "/charts":
            case "/file-upload":
            case "/grid-preferences":
            case "/vector-map":
            case "/colors":
            case "/timeline":
            case "/widgets":
            case "/profile-grid":
                _uiKitExpanded = true;
                break;
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
