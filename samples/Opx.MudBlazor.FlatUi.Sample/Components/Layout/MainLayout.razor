@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject FlatUiPreferencesService DisplayPreferences
@inject FlatDeviceNotificationOptions DeviceNotificationOptions

<FlatMudProviders IsDarkMode="@IsDarkMode">
    <FlatAppShell AppName="OPX FLAT UI"
                  PageTitle="@CurrentPageTitle"
                  SidebarSubtitle="Multi-purpose UI Reference"
                  SearchPlaceholder="Search pages or components..."
                  SearchItems="@NavigationSearchItems"
                  SidebarSearchPlaceholder="Search sample menu..."
                  IsDarkMode="@IsDarkMode"
                  ThemeMode="@EffectiveThemeMode"
                  Density="@EffectiveDisplayDensity"
                  FontSizePx="@EffectiveDisplayFontSizePx"
                  HostKind="@DisplayPreferences.Options.HostKind"
                  AutoScaleHighDensityTouchButtons="@DisplayPreferences.Options.AutoScaleHighDensityTouchButtons"
                  HighDensityTouchButtonHeightPx="@DisplayPreferences.Options.NormalizedHighDensityTouchButtonHeightPx"
                  HighDensityTouchFloatingLabelFontSizePx="@DisplayPreferences.Options.NormalizedHighDensityTouchFloatingLabelFontSizePx"
                  SidebarGroupFontWeight="@DisplayPreferences.Options.NormalizedSidebarGroupFontWeight"
                  SidebarItemFontWeight="@DisplayPreferences.Options.NormalizedSidebarItemFontWeight"
                  LightSidebarBackground="@DisplayPreferences.Options.NormalizedLightSidebarBackground"
                  LightSidebarForeground="@DisplayPreferences.Options.NormalizedLightSidebarForeground"
                  DarkSidebarBackground="@DisplayPreferences.Options.NormalizedDarkSidebarBackground"
                  DarkSidebarForeground="@DisplayPreferences.Options.NormalizedDarkSidebarForeground"
                  NavigationLayout="@EffectiveNavigationLayout"
                  NavigationItems="@HorizontalNavigationItems">
        <AppBarActions>
            <FlatDeviceNotification Title="@DeviceNotificationOptions.SampleTitle"
                                    Message="@DeviceNotificationOptions.SampleMessage"
                                    IconUrl="@DeviceNotificationOptions.IconUrl"
                                    Tag="@DeviceNotificationOptions.SampleTag" />
            <MudMenu Icon="@Icons.Material.Outlined.MoreVert"
                     AriaLabel="Open app menu"
                     Class="header-action-menu"
                     AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight"
                     PopoverClass="settings-menu-popover">
                <ChildContent>
                    <MudMenuItem Icon="@Icons.Material.Outlined.Settings" Label="Settings" OnClick="OpenSettings" />
                    <MudMenuItem Icon="@Icons.Material.Outlined.HelpOutline" Label="Help" />
                    <MudMenuItem Icon="@Icons.Material.Outlined.Info" Label="About app" OnClick="OpenAbout" />
                </ChildContent>
            </MudMenu>
        </AppBarActions>
        <Menu>
            <SampleSidebarMenu />
        </Menu>
        <HorizontalMenu>
            <FlatHorizontalNavigation Items="@HorizontalNavigationItems" />
        </HorizontalMenu>
        <HorizontalBrand>
            <a class="horizontal-brand" href="/" aria-label="Opx Flat UI home">
                <span class="horizontal-brand-mark">
                    <MudIcon Icon="@Icons.Material.Outlined.Apps" />
                </span>
                <span class="horizontal-brand-copy">
                    <strong>@(CurrentBrandTitle)</strong>
                    <small>Multi-purpose UI reference</small>
                </span>
            </a>
        </HorizontalBrand>
        <UserContent>
            <FlatProfileAvatar Name="Opx Reference User" Initials="OR" />
            <div class="sample-user-copy">
                <strong>UI Template</strong>
                <span>Blazor + MAUI Hybrid ready</span>
            </div>
            <MudIconButton Icon="@Icons.Material.Outlined.Logout"
                           Href="/login"
                           Class="logout-action"
                           aria-label="Logout" />
        </UserContent>

        <ChildContent>
            @Body
        </ChildContent>
    </FlatAppShell>

    @if (_settingsOpen)
    {
        <div class="@SettingsModalClass" role="presentation">
            <section class="settings-modal-panel" role="dialog" aria-modal="true" aria-labelledby="settings-modal-title">
                <header class="settings-modal-header">
                    <div>
                        <span class="notification-eyebrow">Settings</span>
                        <h2 id="settings-modal-title">Application preferences</h2>
                        <p>Configure sample UI appearance and preferences.</p>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Outlined.Close"
                                   Class="settings-modal-close"
                                   OnClick="CloseSettingsAsync"
                                   aria-label="Close settings" />
                </header>
                <div class="settings-modal-body">
                    <div class="settings-menu-section">
                        <MudIcon Icon="@Icons.Material.Outlined.Palette" Size="Size.Small" />
                        <span>
                            <strong>Theme settings</strong>
                            <small>Choose the application color mode.</small>
                        </span>
                    </div>
                    <button type="button" class="@SettingItemClass(FlatUiThemeMode.Light)" @onclick="@(() => SetThemeModeAsync(FlatUiThemeMode.Light))">
                        <MudIcon Icon="@Icons.Material.Outlined.LightMode" Size="Size.Small" />
                        <span>
                            <strong>Light</strong>
                            <small>Bright workspace mode</small>
                        </span>
                        @if (_draftThemeMode == FlatUiThemeMode.Light)
                        {
                            <MudIcon Icon="@Icons.Material.Outlined.Check" Size="Size.Small" />
                        }
                    </button>
                    <button type="button" class="@SettingItemClass(FlatUiThemeMode.Dark)" @onclick="@(() => SetThemeModeAsync(FlatUiThemeMode.Dark))">
                        <MudIcon Icon="@Icons.Material.Outlined.DarkMode" Size="Size.Small" />
                        <span>
                            <strong>Dark / Night</strong>
                            <small>Dark mode for night monitoring</small>
                        </span>
                        @if (_draftThemeMode == FlatUiThemeMode.Dark)
                        {
                            <MudIcon Icon="@Icons.Material.Outlined.Check" Size="Size.Small" />
                        }
                    </button>
                    <button type="button" class="@SettingItemClass(FlatUiThemeMode.Auto)" @onclick="@(() => SetThemeModeAsync(FlatUiThemeMode.Auto))">
                        <MudIcon Icon="@Icons.Material.Outlined.BrightnessAuto" Size="Size.Small" />
                        <span>
                            <strong>Auto</strong>
                            <small>Follow the device system preference</small>
                        </span>
                        @if (_draftThemeMode == FlatUiThemeMode.Auto)
                        {
                            <MudIcon Icon="@Icons.Material.Outlined.Check" Size="Size.Small" />
                        }
                    </button>
                    <MudDivider />
                    <div class="settings-menu-section">
                        <MudIcon Icon="@Icons.Material.Outlined.FormatSize" Size="Size.Small" />
                        <span>
                            <strong>Interface size</strong>
                            <small>Changes preview immediately. Save to keep them.</small>
                        </span>
                    </div>
                    <FlatDisplaySettings Density="@_draftDensity"
                                         DensityChanged="SetDraftDensity"
                                         ColorPalette="@_draftColorPalette"
                                         ColorPaletteChanged="SetDraftColorPalette"
                                         ColorPalettes="@DisplayPreferences.Options.AvailableColorPalettes"
                                         HostKind="@DisplayPreferences.Options.HostKind"
                                         NavigationLayout="@_draftNavigationLayout"
                                         NavigationLayoutChanged="SetDraftNavigationLayout"
                                         FontSizePx="@_draftFontSizePx"
                                         FontSizePxChanged="SetDraftFontSize"
                                         MinimumFontSizePx="@DisplayPreferences.Options.MinimumFontSizePx"
                                         MaximumFontSizePx="@DisplayPreferences.Options.MaximumFontSizePx"
                                         BackdropOpacity="@_draftBackdropOpacity"
                                         BackdropOpacityChanged="SetDraftBackdropOpacity"
                                         MinimumBackdropOpacity="@DisplayPreferences.Options.MinimumBackdropOpacity"
                                         MaximumBackdropOpacity="@DisplayPreferences.Options.MaximumBackdropOpacity" />
                    <button type="button" class="settings-menu-item display-reset-button" @onclick="RestoreDisplayDefaultsAsync">
                        <MudIcon Icon="@Icons.Material.Outlined.RestartAlt" Size="Size.Small" />
                        <span>
                            <strong>Restore application defaults</strong>
                            <small>Use the palette, layout, density, and font size configured by the host app.</small>
                        </span>
                    </button>
                    <MudDivider />
                    <div class="settings-menu-section">
                        <MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" />
                        <span>
                            <strong>Preferences</strong>
                            <small>Additional settings can be provided by the consumer app.</small>
                        </span>
                    </div>
                    <button type="button" class="settings-menu-item">
                        <MudIcon Icon="@Icons.Material.Outlined.NotificationsNone" Size="Size.Small" />
                        <span>
                            <strong>Notifications</strong>
                            <small>Local OS/device notifications. Permission and scheduling are controlled by the host platform.</small>
                        </span>
                    </button>
                </div>
                <footer class="settings-modal-footer">
                    <MudButton Variant="Variant.Outlined" OnClick="CloseSettingsAsync">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSettingsAsync">Save</MudButton>
                </footer>
            </section>
        </div>
    }

    @if (_aboutOpen)
    {
        <div class="@SettingsModalClass" role="presentation">
            <section class="settings-modal-panel" role="dialog" aria-modal="true" aria-labelledby="about-modal-title">
                <header class="settings-modal-header">
                    <div>
                        <span class="notification-eyebrow">About app</span>
                        <h2 id="about-modal-title">OPX Flat UI Template</h2>
                        <p>Multi-purpose UI reference for admin apps, IT operations, ecommerce dashboards, blogs, front pages, and landing pages.</p>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Outlined.Close"
                                   Class="settings-modal-close"
                                   OnClick="CloseAbout"
                                   aria-label="Close about app" />
                </header>
                <div class="settings-modal-body">
                    <div class="settings-menu-section">
                        <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
                        <span>
                            <strong>Application information</strong>
                            <small>Reusable template identity.</small>
                        </span>
                    </div>
                    <div class="settings-menu-item" role="group" aria-label="Author">
                        <MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" />
                        <span>
                            <strong>Author</strong>
                            <small>Noviyanto Wibowo (opx)</small>
                        </span>
                    </div>
                    <div class="settings-menu-item" role="group" aria-label="Powered by">
                        <MudIcon Icon="@Icons.Custom.Brands.MudBlazor" Size="Size.Small" />
                        <span>
                            <strong>Powered by</strong>
                            <small>MudBlazor</small>
                        </span>
                    </div>
                </div>
                <footer class="settings-modal-footer">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseAbout">Close</MudButton>
                </footer>
            </section>
        </div>
    }
</FlatMudProviders>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>

