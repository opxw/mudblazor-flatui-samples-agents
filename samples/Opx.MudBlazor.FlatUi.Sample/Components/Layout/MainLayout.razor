    private const string ThemeListenerId = "opx-flat-ui-sample-main-layout";
    private DotNetObjectReference<MainLayout>? _themeReference;
    private bool _systemPrefersDark;
    private bool _settingsOpen;
    private bool _aboutOpen;
    private string _draftDensity = FlatUiDensity.Default;
    private string _draftThemeMode = FlatUiThemeMode.Auto;
    private string _draftNavigationLayout = FlatUiNavigationLayout.Vertical;
    private string _draftColorPalette = "blue";
    private double _draftFontSizePx = 14.5;
    private double _draftBackdropOpacity = 0.48;
    private bool _restoreDisplayDefaults;
    private string EffectiveDisplayDensity => _settingsOpen
        ? _draftDensity
        : DisplayPreferences.Current.Density;
    private double EffectiveDisplayFontSizePx => _settingsOpen
        ? _draftFontSizePx
        : DisplayPreferences.Current.FontSizePx;
    private string EffectiveNavigationLayout => _settingsOpen
        ? _draftNavigationLayout
        : DisplayPreferences.Current.NavigationLayout;
    private string CurrentPageTitle => PageTitleFor(Navigation.Uri);
    private string CurrentBrandTitle => "OPX FLAT UI";
    private string SettingsModalClass => $"settings-modal-overlay {(IsDarkMode ? "theme-dark" : "theme-light")}";
    private string EffectiveThemeMode => _settingsOpen
        ? _draftThemeMode
        : DisplayPreferences.Current.ThemeMode;
    private bool IsDarkMode => EffectiveThemeMode switch
    {
        FlatUiThemeMode.Dark => true,
        FlatUiThemeMode.Light => false,
        _ => _systemPrefersDark
    };

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += HandleLocationChanged;
        DisplayPreferences.Changed += HandleDisplayPreferencesChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await DisplayPreferences.InitializeAsync();
            _themeReference = DotNetObjectReference.Create(this);
            _systemPrefersDark = await JS.InvokeAsync<bool>(
                "opxFlatTheme.watchSystemPreference",
                ThemeListenerId,
                _themeReference);
            StateHasChanged();
        }
        catch (JSException)
        {
            _systemPrefersDark = false;
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        StateHasChanged();
    }

    private string PageTitleFor(string uri)
    {
        var path = "/" + Navigation.ToBaseRelativePath(uri).Split('?', '#')[0].Trim('/');
        return path.ToLowerInvariant() switch
        {
            "/" => "Dashboard",
            "/crud" => "Operations-CrudAsset",
