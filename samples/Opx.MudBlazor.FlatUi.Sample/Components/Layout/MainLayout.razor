@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject FlatUiPreferencesService DisplayPreferences
@inject FlatDeviceNotificationOptions DeviceNotificationOptions
@inject FlatLocalizationOptions LocalizationOptions

<FlatMudProviders IsDarkMode="@IsDarkMode" Palette="@CurrentThemePalette">
    <FlatAppShell AppName="OPX FLAT UI"
                  PageTitle="@CurrentPageTitle"
                  SidebarSubtitle="Flat UI powered by MudBlazor"
                  SearchPlaceholder="Search pages or components..."
                  SearchItems="@ShowcaseNavigationCatalog.SearchItems"
                  SidebarSearchPlaceholder="Search sample menu..."
                  IsDarkMode="@IsDarkMode"
                  ThemeMode="@EffectiveThemeMode"
                  Density="@EffectiveDisplayDensity"
                  UseAppFontSize="@EffectiveUseAppFontSize"
                  FontSizePx="@EffectiveDisplayFontSizePx"
                  RoundedSizePx="@DisplayPreferences.Current.RoundedSizePx"
                  HostKind="@DisplayPreferences.Options.HostKind"
                  AutoScaleHighDensityTouchButtons="@DisplayPreferences.Options.AutoScaleHighDensityTouchButtons"
                  HighDensityTouchButtonHeightPx="@DisplayPreferences.Options.NormalizedHighDensityTouchButtonHeightPx"
                  HighDensityTouchFloatingLabelFontSizePx="@DisplayPreferences.Options.NormalizedHighDensityTouchFloatingLabelFontSizePx"
                  SidebarGroupFontWeight="@DisplayPreferences.Options.NormalizedSidebarGroupFontWeight"
                  SidebarItemFontWeight="@DisplayPreferences.Options.NormalizedSidebarItemFontWeight"
                  LightSidebarBackground="@DisplayPreferences.Effective.LightSidebarBackground"
                  LightSidebarForeground="@DisplayPreferences.Effective.LightSidebarForeground"
                  DarkSidebarBackground="@DisplayPreferences.Effective.DarkSidebarBackground"
                  DarkSidebarForeground="@DisplayPreferences.Effective.DarkSidebarForeground"
                  RightToLeft="@LocalizationOptions.RightToLeft"
                  NavigationLayout="@EffectiveNavigationLayout"
                  BottomNavigationMaxWidthPx="900"
                  BottomNavigationChildPresentation="@EffectiveBottomNavigationChildPresentation"
                  NavigationItems="@ShowcaseNavigationCatalog.NavigationItems">
        <AppBarActions>
            <FlatDeviceNotification Title="@DeviceNotificationOptions.SampleTitle"
                                    Message="@DeviceNotificationOptions.SampleMessage"
                                    IconUrl="@DeviceNotificationOptions.IconUrl"
                                    Tag="@DeviceNotificationOptions.SampleTag" />
            <MudMenu Icon="@Icons.Material.Outlined.MoreVert"
                     AriaLabel="Open app menu"
                     Class="header-action-menu"
                     AnchorOrigin="Origin.BottomRight"
                     TransformOrigin="Origin.TopRight"
                     PopoverClass="settings-menu-popover">
                <ChildContent>
                    <MudMenuItem Icon="@Icons.Material.Outlined.Settings" Label="Settings" OnClick="OpenSettings" />
                    <MudMenuItem Icon="@Icons.Material.Outlined.HelpOutline" Label="Help" />
                    <MudMenuItem Icon="@Icons.Material.Outlined.Info" Label="About app" OnClick="OpenAbout" />
                </ChildContent>
            </MudMenu>
        </AppBarActions>
        <HorizontalMenu>
            <FlatHorizontalNavigation Items="@ShowcaseNavigationCatalog.NavigationItems" />
        </HorizontalMenu>
        <HorizontalBrand>
            <a class="horizontal-brand" href="/" aria-label="Opx Flat UI home">
                <span class="horizontal-brand-mark">
                    <MudIcon Icon="@Icons.Material.Outlined.Apps" />
                </span>
                <span class="horizontal-brand-copy">
                    <strong>@(CurrentBrandTitle)</strong>
                    <small>Multi-purpose UI reference</small>
                </span>
            </a>
        </HorizontalBrand>
        <UserContent>
            <FlatProfileAvatar Name="Opx Reference User" Initials="OR" />
            <div class="sample-user-copy">
                <strong>UI Template</strong>
                <span>Flat UI powered by MudBlazor</span>
            </div>
            <MudIconButton Icon="@Icons.Material.Outlined.Logout"
                           Href="/login"
                           Class="logout-action"
                           aria-label="Logout" />
        </UserContent>

        <ChildContent>
            @Body
            <SamplePageUsage />
        </ChildContent>
    </FlatAppShell>

    <FlatCommandPalette Commands="@CommandPaletteItems"
                        @bind-Open="_commandPaletteOpen"
                        Selected="HandleCommandPaletteSelection" />

    @if (_settingsOpen)
    {
        <div class="@SettingsModalClass" role="presentation">
            <section class="settings-modal-panel" role="dialog" aria-modal="true" aria-labelledby="settings-modal-title">
                <header class="settings-modal-header">
                    <div>
                        <span class="notification-eyebrow">@(_indonesianSettingsPreview ? "Pengaturan" : "Settings")</span>
                        <h2 id="settings-modal-title">@(_indonesianSettingsPreview ? "Preferensi aplikasi" : "Application preferences")</h2>
                        <p>@(_indonesianSettingsPreview ? "Atur tampilan aplikasi sesuai kebutuhan pengguna." : "Configure sample UI appearance and preferences.")</p>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Outlined.Close"
                                   Class="settings-modal-close"
                                   OnClick="CloseSettingsAsync"
                                   aria-label="@(_indonesianSettingsPreview ? "Tutup pengaturan" : "Close settings")" />
                </header>
                <div class="settings-modal-body">
                    @if (!_indonesianSettingsPreview)
                    {
                    <div class="settings-menu-section">
                        <MudIcon Icon="@Icons.Material.Outlined.Palette" Size="Size.Small" />
                        <span>
                            <strong>Theme settings</strong>
                            <small>Choose the application color mode.</small>
                        </span>
                    </div>
                    <button type="button" class="@SettingItemClass(FlatUiThemeMode.Light)" @onclick="@(() => SetThemeModeAsync(FlatUiThemeMode.Light))">
                        <MudIcon Icon="@Icons.Material.Outlined.LightMode" Size="Size.Small" />
                        <span>
                            <strong>Light</strong>
                            <small>Bright workspace mode</small>
                        </span>
                        @if (_draftThemeMode == FlatUiThemeMode.Light)
                        {
                            <MudIcon Icon="@Icons.Material.Outlined.Check" Size="Size.Small" />
                        }
                    </button>
                    <button type="button" class="@SettingItemClass(FlatUiThemeMode.Dark)" @onclick="@(() => SetThemeModeAsync(FlatUiThemeMode.Dark))">
                        <MudIcon Icon="@Icons.Material.Outlined.DarkMode" Size="Size.Small" />
                        <span>
                            <strong>Dark / Night</strong>
                            <small>Dark mode for night monitoring</small>
                        </span>
                        @if (_draftThemeMode == FlatUiThemeMode.Dark)
                        {
                            <MudIcon Icon="@Icons.Material.Outlined.Check" Size="Size.Small" />
                        }
                    </button>
                    <button type="button" class="@SettingItemClass(FlatUiThemeMode.Auto)" @onclick="@(() => SetThemeModeAsync(FlatUiThemeMode.Auto))">
                        <MudIcon Icon="@Icons.Material.Outlined.BrightnessAuto" Size="Size.Small" />
                        <span>
                            <strong>Auto</strong>
                            <small>Follow the device system preference</small>
                        </span>
                        @if (_draftThemeMode == FlatUiThemeMode.Auto)
                        {
                            <MudIcon Icon="@Icons.Material.Outlined.Check" Size="Size.Small" />
                        }
                    </button>
                    <MudDivider />
                    <div class="settings-menu-section">
                        <MudIcon Icon="@Icons.Material.Outlined.FormatSize" Size="Size.Small" />
                        <span>
                            <strong>Interface size</strong>
                            <small>Changes preview immediately. Save to keep them.</small>
                        </span>
                    </div>
                    }
                    <FlatDisplaySettings Density="@_draftDensity"
                                         DensityChanged="SetDraftDensity"
                                         Configuration="@SettingsConfiguration"
                                         ThemeMode="@_draftThemeMode"
                                         ThemeModeChanged="SetThemeModeAsync"
                                         InputStyle="@_draftInputStyle"
                                         InputStyleChanged="SetDraftInputStyle"
                                         ColorPalette="@_draftColorPalette"
                                         ColorPaletteChanged="SetDraftColorPalette"
                                         ColorPalettes="@DisplayPreferences.Options.AvailableColorPalettes"
                                         LightSidebarBackground="@_draftLightSidebarBackground"
                                         LightSidebarBackgroundChanged="SetDraftLightSidebarBackground"
                                         LightSidebarForeground="@_draftLightSidebarForeground"
                                         LightSidebarForegroundChanged="SetDraftLightSidebarForeground"
                                         DarkSidebarBackground="@_draftDarkSidebarBackground"
                                         DarkSidebarBackgroundChanged="SetDraftDarkSidebarBackground"
                                         DarkSidebarForeground="@_draftDarkSidebarForeground"
                                         DarkSidebarForegroundChanged="SetDraftDarkSidebarForeground"
                                         HostKind="@DisplayPreferences.Options.HostKind"
                                         NavigationLayout="@_draftNavigationLayout"
                                         NavigationLayoutChanged="SetDraftNavigationLayout"
                                         BottomNavigationChildPresentation="@_draftBottomNavigationChildPresentation"
                                         BottomNavigationChildPresentationChanged="SetDraftBottomNavigationChildPresentation"
                                         UseAppFontSize="@_draftUseAppFontSize"
                                         UseAppFontSizeChanged="SetDraftUseAppFontSize"
                                         FontSizePx="@_draftFontSizePx"
                                         FontSizePxChanged="SetDraftFontSize"
                                         MinimumFontSizePx="@DisplayPreferences.Options.MinimumFontSizePx"
                                         MaximumFontSizePx="@DisplayPreferences.Options.MaximumFontSizePx"
                                         BackdropOpacity="@_draftBackdropOpacity"
                                         BackdropOpacityChanged="SetDraftBackdropOpacity"
                                         MinimumBackdropOpacity="@DisplayPreferences.Options.MinimumBackdropOpacity"
                                         MaximumBackdropOpacity="@DisplayPreferences.Options.MaximumBackdropOpacity"
                                         RoundedSizePx="@_draftRoundedSizePx"
                                         RoundedSizePxChanged="SetDraftRoundedSize" />
                    @if (!_indonesianSettingsPreview)
                    {
                    <button type="button" class="settings-menu-item display-reset-button" @onclick="RestoreDisplayDefaultsAsync">
                        <MudIcon Icon="@Icons.Material.Outlined.RestartAlt" Size="Size.Small" />
                        <span>
                            <strong>Restore application defaults</strong>
                            <small>Use the colors, palette, layout, density, and font size configured by the host app.</small>
                        </span>
                    </button>
                    <MudDivider />
                    <div class="settings-menu-section">
                        <MudIcon Icon="@Icons.Material.Outlined.Tune" Size="Size.Small" />
                        <span>
                            <strong>Preferences</strong>
                            <small>Additional settings can be provided by the consumer app.</small>
                        </span>
                    </div>
                    <button type="button" class="settings-menu-item">
                        <MudIcon Icon="@Icons.Material.Outlined.NotificationsNone" Size="Size.Small" />
                        <span>
                            <strong>Notifications</strong>
                            <small>Local OS/device notifications. Permission and scheduling are controlled by the host platform.</small>
                        </span>
                    </button>
                    }
                </div>
                <footer class="settings-modal-footer">
                    <MudButton Variant="Variant.Outlined" OnClick="CloseSettingsAsync">@(_indonesianSettingsPreview ? "Batal" : "Cancel")</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSettingsAsync">@(_indonesianSettingsPreview ? "Simpan" : "Save")</MudButton>
                </footer>
            </section>
        </div>
    }

    @if (_aboutOpen)
    {
        <div class="@SettingsModalClass" role="presentation">
            <section class="settings-modal-panel" role="dialog" aria-modal="true" aria-labelledby="about-modal-title">
                <header class="settings-modal-header">
                    <div>
                        <span class="notification-eyebrow">About app</span>
                        <h2 id="about-modal-title">OPX Flat UI Template</h2>
                        <p>Multi-purpose UI reference for admin apps, IT operations, ecommerce dashboards, blogs, front pages, and landing pages.</p>
                    </div>
                    <MudIconButton Icon="@Icons.Material.Outlined.Close"
                                   Class="settings-modal-close"
                                   OnClick="CloseAbout"
                                   aria-label="Close about app" />
                </header>
                <div class="settings-modal-body">
                    <div class="settings-menu-section">
                        <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" />
                        <span>
                            <strong>Application information</strong>
                            <small>Reusable template identity.</small>
                        </span>
                    </div>
                    <div class="settings-menu-item" role="group" aria-label="Author">
                        <MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" />
                        <span>
                            <strong>Author</strong>
                            <small>Noviyanto Wibowo (opx)</small>
                        </span>
                    </div>
                    <div class="settings-menu-item" role="group" aria-label="Powered by">
                        <MudIcon Icon="@Icons.Custom.Brands.MudBlazor" Size="Size.Small" />
                        <span>
                            <strong>Powered by</strong>
                            <small>MudBlazor</small>
                        </span>
                    </div>
                </div>
                <footer class="settings-modal-footer">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseAbout">Close</MudButton>
                </footer>
            </section>
        </div>
    }
</FlatMudProviders>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>

@code {
    private const string ThemeListenerId = "opx-flat-ui-sample-main-layout";
    private bool _commandPaletteOpen;
    private DotNetObjectReference<MainLayout>? _themeReference;
    private bool _systemPrefersDark;
    private bool _settingsOpen;
    private bool _aboutOpen;
    private bool _bottomMainViewPreview;
    private bool _indonesianSettingsPreview;
    private string _draftDensity = FlatUiDensity.Default;
    private string _draftInputStyle = FlatInputStyle.Outlined;
    private string _draftThemeMode = FlatUiThemeMode.Auto;
    private string _draftNavigationLayout = FlatUiNavigationLayout.Vertical;
    private string _draftBottomNavigationChildPresentation = FlatBottomNavigationChildPresentation.Sheet;
    private string _draftColorPalette = "fluent-blue";
    private string _draftLightSidebarBackground = "#f3f6f9";
    private string _draftLightSidebarForeground = "#495057";
    private string _draftDarkSidebarBackground = "#212529";
    private string _draftDarkSidebarForeground = "#ced4da";
    private bool _draftUseAppFontSize;
    private double _draftFontSizePx = 16;
    private double _draftBackdropOpacity = 0.48;
    private double _draftRoundedSizePx;
    private bool _restoreDisplayDefaults;
    private string EffectiveDisplayDensity => _settingsOpen
        ? _draftDensity
        : DisplayPreferences.Current.Density;
    private double EffectiveDisplayFontSizePx => _settingsOpen
        ? _draftFontSizePx
        : DisplayPreferences.Current.FontSizePx;
    private bool EffectiveUseAppFontSize => _settingsOpen
        ? _draftUseAppFontSize
        : DisplayPreferences.Current.UseAppFontSize;
    private static bool IsBottomMainViewPreviewUri(string uri) =>
        Microsoft.AspNetCore.WebUtilities.QueryHelpers
            .ParseQuery(new Uri(uri, UriKind.Absolute).Query)
            .TryGetValue("preview", out var previewValues)
        && previewValues.Any(value => string.Equals(value, "bottom-main-view", StringComparison.OrdinalIgnoreCase));
    private static bool IsIndonesianSettingsPreviewUri(string uri) =>
        Microsoft.AspNetCore.WebUtilities.QueryHelpers
            .ParseQuery(new Uri(uri, UriKind.Absolute).Query)
            .TryGetValue("preview", out var previewValues)
        && previewValues.Any(value => string.Equals(value, "settings-indonesian-essentials", StringComparison.OrdinalIgnoreCase));
    private FlatDisplaySettingsConfiguration SettingsConfiguration => _indonesianSettingsPreview
        ? FlatDisplaySettingsConfiguration.IndonesianEssentials
        : FlatDisplaySettingsConfiguration.Default;
    private string EffectiveNavigationLayout => _bottomMainViewPreview
        ? FlatUiNavigationLayout.Bottom
        : _settingsOpen
            ? _draftNavigationLayout
            : DisplayPreferences.Current.NavigationLayout;
    private string EffectiveBottomNavigationChildPresentation => _bottomMainViewPreview
        ? FlatBottomNavigationChildPresentation.MainView
        : _settingsOpen
            ? _draftBottomNavigationChildPresentation
            : DisplayPreferences.Current.BottomNavigationChildPresentation;
    private string CurrentPageTitle => ShowcaseNavigationCatalog.ResolvePageTitle(Navigation.Uri);
    private string CurrentBrandTitle => "OPX FLAT UI";
    private string SettingsModalClass => $"settings-modal-overlay {(IsDarkMode ? "theme-dark" : "theme-light")}";
    private string EffectiveThemeMode => _settingsOpen
        ? _draftThemeMode
        : DisplayPreferences.Current.ThemeMode;
    private bool IsDarkMode => EffectiveThemeMode switch
    {
        FlatUiThemeMode.Dark => true,
        FlatUiThemeMode.Light => false,
        _ => _systemPrefersDark
    };

    private FlatUiPalette CurrentThemePalette
    {
        get
        {
            var paletteId = _settingsOpen ? _draftColorPalette : DisplayPreferences.Current.ColorPalette;
            var palette = DisplayPreferences.Options.ResolveColorPalette(paletteId);
            return new FlatUiPalette(
                Accent: palette.Accent,
                AccentHover: palette.AccentHover,
                AccentSubtle: palette.AccentSubtle,
                AccentDark: palette.AccentDark,
                DarkAccent: palette.DarkAccent,
                DarkAccentHover: palette.DarkAccentHover,
                Secondary: palette.Secondary,
                Success: palette.Success,
                Warning: palette.Warning,
                Danger: palette.Danger);
        }
    }

    protected override void OnInitialized()
    {
        _bottomMainViewPreview = IsBottomMainViewPreviewUri(Navigation.Uri);
        _indonesianSettingsPreview = IsIndonesianSettingsPreviewUri(Navigation.Uri);
        if (_indonesianSettingsPreview)
        {
            OpenSettings();
        }
        Navigation.LocationChanged += HandleLocationChanged;
        DisplayPreferences.Changed += HandleDisplayPreferencesChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await DisplayPreferences.InitializeAsync();
            _themeReference = DotNetObjectReference.Create(this);
            _systemPrefersDark = await JS.InvokeAsync<bool>(
                "opxFlatTheme.watchSystemPreference",
                ThemeListenerId,
                _themeReference);
            StateHasChanged();
        }
        catch (JSException)
        {
            _systemPrefersDark = false;
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _bottomMainViewPreview |= IsBottomMainViewPreviewUri(args.Location);
        _indonesianSettingsPreview = IsIndonesianSettingsPreviewUri(args.Location);
        if (_indonesianSettingsPreview && !_settingsOpen)
        {
            OpenSettings();
        }
        StateHasChanged();
    }

    private string SettingItemClass(string mode) =>
        $"settings-menu-item {(_draftThemeMode == mode ? "active" : "")}";

    private async Task SetThemeModeAsync(string mode)
    {
        _draftThemeMode = FlatUiThemeMode.Normalize(mode);
        _restoreDisplayDefaults = false;
        await PreviewDisplayDraftAsync();
    }

    [JSInvokable]
    public Task OnSystemThemeChanged(bool prefersDark)
    {
        _systemPrefersDark = prefersDark;
        return InvokeAsync(StateHasChanged);
    }

    private void OpenSettings()
    {
        _draftThemeMode = DisplayPreferences.Current.ThemeMode;
        _draftDensity = DisplayPreferences.Current.Density;
        _draftInputStyle = DisplayPreferences.Current.InputStyle;
        _draftNavigationLayout = DisplayPreferences.Current.NavigationLayout;
        _draftBottomNavigationChildPresentation = DisplayPreferences.Current.BottomNavigationChildPresentation;
        _draftColorPalette = DisplayPreferences.Current.ColorPalette;
        _draftLightSidebarBackground = DisplayPreferences.Current.LightSidebarBackground;
        _draftLightSidebarForeground = DisplayPreferences.Current.LightSidebarForeground;
        _draftDarkSidebarBackground = DisplayPreferences.Current.DarkSidebarBackground;
        _draftDarkSidebarForeground = DisplayPreferences.Current.DarkSidebarForeground;
        _draftUseAppFontSize = DisplayPreferences.Current.UseAppFontSize;
        _draftFontSizePx = DisplayPreferences.Current.FontSizePx;
        _draftBackdropOpacity = DisplayPreferences.Current.BackdropOpacity;
        _draftRoundedSizePx = DisplayPreferences.Current.RoundedSizePx;
        _restoreDisplayDefaults = false;
        _settingsOpen = true;
    }

    private async Task CloseSettingsAsync()
    {
        await DisplayPreferences.RestoreCurrentPreviewAsync();
        _settingsOpen = false;
    }

    private async Task SetDraftDensity(string density)
    {
        _draftDensity = FlatUiDensity.Normalize(density);
        _restoreDisplayDefaults = false;
        await PreviewDisplayDraftAsync();
    }

    private async Task SetDraftInputStyle(string inputStyle)
    {
        _draftInputStyle = FlatInputStyle.Normalize(inputStyle);
        _restoreDisplayDefaults = false;
        await PreviewDisplayDraftAsync();
    }

    private async Task SetDraftNavigationLayout(string navigationLayout)
    {
        _draftNavigationLayout = FlatUiNavigationLayout.Normalize(navigationLayout);
        _restoreDisplayDefaults = false;
        await PreviewDisplayDraftAsync();
    }

    private async Task SetDraftBottomNavigationChildPresentation(string presentation)
    {
        _draftBottomNavigationChildPresentation = FlatBottomNavigationChildPresentation.Normalize(presentation);
        _restoreDisplayDefaults = false;
        await PreviewDisplayDraftAsync();
    }

    private async Task SetDraftFontSize(double fontSizePx)
    {
        _draftFontSizePx = fontSizePx;
        _restoreDisplayDefaults = false;
        await PreviewDisplayDraftAsync();
    }

    private async Task SetDraftUseAppFontSize(bool useAppFontSize)
    {
        _draftUseAppFontSize = useAppFontSize;
        _restoreDisplayDefaults = false;
        await PreviewDisplayDraftAsync();
    }

    private async Task SetDraftBackdropOpacity(double backdropOpacity)
    {
        _draftBackdropOpacity = backdropOpacity;
        _restoreDisplayDefaults = false;
        await PreviewDisplayDraftAsync();
    }

    private async Task SetDraftRoundedSize(double roundedSizePx)
    {
        _draftRoundedSizePx = roundedSizePx;
        _restoreDisplayDefaults = false;
        await PreviewDisplayDraftAsync();
    }

    private async Task SetDraftColorPalette(string colorPalette)
    {
        _draftColorPalette = DisplayPreferences.Options.ResolveColorPalette(colorPalette).Id;
        _restoreDisplayDefaults = false;
        await PreviewDisplayDraftAsync();
    }

    private async Task SetDraftLightSidebarBackground(string color)
    {
        _draftLightSidebarBackground = DisplayPreferences.Options.ResolveLightSidebarBackground(color);
        _restoreDisplayDefaults = false;
        await PreviewDisplayDraftAsync();
    }

    private async Task SetDraftLightSidebarForeground(string color)
    {
        _draftLightSidebarForeground = DisplayPreferences.Options.ResolveLightSidebarForeground(color);
        _restoreDisplayDefaults = false;
        await PreviewDisplayDraftAsync();
    }

    private async Task SetDraftDarkSidebarBackground(string color)
    {
        _draftDarkSidebarBackground = DisplayPreferences.Options.ResolveDarkSidebarBackground(color);
        _restoreDisplayDefaults = false;
        await PreviewDisplayDraftAsync();
    }

    private async Task SetDraftDarkSidebarForeground(string color)
    {
        _draftDarkSidebarForeground = DisplayPreferences.Options.ResolveDarkSidebarForeground(color);
        _restoreDisplayDefaults = false;
        await PreviewDisplayDraftAsync();
    }

    private async Task RestoreDisplayDefaultsAsync()
    {
        var defaults = DisplayPreferences.Options.CreateDefaults();
        _draftThemeMode = defaults.ThemeMode;
        _draftDensity = defaults.Density;
        _draftInputStyle = defaults.InputStyle;
        _draftNavigationLayout = defaults.NavigationLayout;
        _draftBottomNavigationChildPresentation = defaults.BottomNavigationChildPresentation;
        _draftColorPalette = defaults.ColorPalette;
        _draftLightSidebarBackground = defaults.LightSidebarBackground;
        _draftLightSidebarForeground = defaults.LightSidebarForeground;
        _draftDarkSidebarBackground = defaults.DarkSidebarBackground;
        _draftDarkSidebarForeground = defaults.DarkSidebarForeground;
        _draftUseAppFontSize = defaults.UseAppFontSize;
        _draftFontSizePx = defaults.FontSizePx;
        _draftBackdropOpacity = defaults.BackdropOpacity;
        _draftRoundedSizePx = defaults.RoundedSizePx;
        _restoreDisplayDefaults = true;
        await PreviewDisplayDraftAsync();
    }

    private ValueTask PreviewDisplayDraftAsync() =>
        DisplayPreferences.PreviewAsync(new FlatUiDisplayPreferences
        {
            UseAppFontSize = _draftUseAppFontSize,
            ThemeMode = _draftThemeMode,
            Density = _draftDensity,
            InputStyle = _draftInputStyle,
            NavigationLayout = _draftNavigationLayout,
            BottomNavigationChildPresentation = _draftBottomNavigationChildPresentation,
            ColorPalette = _draftColorPalette,
            LightSidebarBackground = _draftLightSidebarBackground,
            LightSidebarForeground = _draftLightSidebarForeground,
            DarkSidebarBackground = _draftDarkSidebarBackground,
            DarkSidebarForeground = _draftDarkSidebarForeground,
            FontSizePx = _draftFontSizePx,
            RoundedSizePx = _draftRoundedSizePx,
            BackdropOpacity = _draftBackdropOpacity
        });

    private async Task SaveSettingsAsync()
    {
        if (_restoreDisplayDefaults)
        {
            await DisplayPreferences.ResetAsync();
        }
        else
        {
            await DisplayPreferences.SaveAsync(new FlatUiDisplayPreferences
            {
                UseAppFontSize = _draftUseAppFontSize,
                ThemeMode = _draftThemeMode,
                Density = _draftDensity,
                InputStyle = _draftInputStyle,
                NavigationLayout = _draftNavigationLayout,
                BottomNavigationChildPresentation = _draftBottomNavigationChildPresentation,
                ColorPalette = _draftColorPalette,
                LightSidebarBackground = _draftLightSidebarBackground,
                LightSidebarForeground = _draftLightSidebarForeground,
                DarkSidebarBackground = _draftDarkSidebarBackground,
                DarkSidebarForeground = _draftDarkSidebarForeground,
                FontSizePx = _draftFontSizePx,
                RoundedSizePx = _draftRoundedSizePx,
                BackdropOpacity = _draftBackdropOpacity
            });
        }

        _settingsOpen = false;
    }

    private void HandleDisplayPreferencesChanged() => _ = InvokeAsync(StateHasChanged);

    private static IReadOnlyList<FlatCommandDefinition> CommandPaletteItems => ShowcaseNavigationCatalog.SearchItems
        .Select(item => new FlatCommandDefinition(
            item.Href,
            item.Title,
            item.Group,
            item.Href,
            item.Icon,
            Keywords: item.Keywords))
        .Concat(
        [
            new FlatCommandDefinition("settings", "Open application settings", "Quick actions", Icon: Icons.Material.Outlined.Settings, Shortcut: "S", Keywords: "theme density font palette sidebar color"),
            new FlatCommandDefinition("home", "Go to dashboard", "Quick actions", "/", Icons.Material.Outlined.Home, "G H", "dashboard home")
        ])
        .ToArray();

    private void HandleCommandPaletteSelection(FlatCommandSelection selection)
    {
        if (selection.Command.Key == "settings")
        {
            OpenSettings();
            return;
        }

        if (!string.IsNullOrWhiteSpace(selection.Command.NavigateTo))
        {
            Navigation.NavigateTo(selection.Command.NavigateTo);
        }
    }

    private void OpenAbout()
    {
        _aboutOpen = true;
    }

    private void CloseAbout()
    {
        _aboutOpen = false;
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
        DisplayPreferences.Changed -= HandleDisplayPreferencesChanged;
        if (_themeReference is null)
        {
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("opxFlatTheme.unwatchSystemPreference", ThemeListenerId);
        }
        catch (JSDisconnectedException)
        {
            // The circuit can already be disconnected while the layout is disposing.
        }
        catch (Exception exception) when (exception is JSException or InvalidOperationException)
        {
            // This can be the non-interactive prerender instance.
        }
        _themeReference.Dispose();
    }
}
