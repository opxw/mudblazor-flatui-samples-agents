@implements IAsyncDisposable
@inject IJSRuntime JS
@inject FlatUiPreferencesService DisplayPreferences
@inject FlatReconnectOptions ReconnectOptions
@inject SampleStartupGateService StartupGate

@if (!_startupChecked)
{
    <FlatMudProviders IsDarkMode="@IsDarkMode" Palette="@CurrentThemePalette">
        <FlatSessionRestore Title="@StartupTitle"
                            Message="@StartupMessage" />
    </FlatMudProviders>
}
else
{
    <Routes />
}

@code {
    private readonly CancellationTokenSource _disposeToken = new();
    private bool _startupChecked;
    private bool _systemPrefersDark;

    private string StartupTitle => string.IsNullOrWhiteSpace(ReconnectOptions.StartupTitle)
        ? "Loading page..."
        : ReconnectOptions.StartupTitle.Trim();

    private string StartupMessage => string.IsNullOrWhiteSpace(ReconnectOptions.StartupMessage)
        ? "Please wait a moment."
        : ReconnectOptions.StartupMessage.Trim();

    private bool IsDarkMode => DisplayPreferences.Current.ThemeMode switch
    {
        FlatUiThemeMode.Dark => true,
        FlatUiThemeMode.Light => false,
        _ => _systemPrefersDark
    };

    private FlatUiPalette CurrentThemePalette
    {
        get
        {
            var palette = DisplayPreferences.Options.ResolveColorPalette(DisplayPreferences.Current.ColorPalette);
            return new FlatUiPalette(
                Accent: palette.Accent,
                AccentHover: palette.AccentHover,
                AccentSubtle: palette.AccentSubtle,
                AccentDark: palette.AccentDark,
                DarkAccent: palette.DarkAccent,
                DarkAccentHover: palette.DarkAccentHover,
                Secondary: palette.Secondary,
                Success: palette.Success,
                Warning: palette.Warning,
                Danger: palette.Danger);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            await DisplayPreferences.InitializeAsync();
            _systemPrefersDark = await JS.InvokeAsync<bool>(
                "opxFlatThemeBootstrap.prefersDarkMode",
                _disposeToken.Token);
        }
        catch (JSException)
        {
            // First-paint bootstrap classes already provide the resolved theme.
            // MainLayout retries persisted preferences after Router is created.
            _systemPrefersDark = false;
        }

        // The sample has no real authentication state. Consumer hosts replace this
        // scoped callback with their saved-session/token validation and auth update.
        await StartupGate.CheckAsync(_disposeToken.Token);

        if (_disposeToken.IsCancellationRequested)
        {
            return;
        }

        _startupChecked = true;
        await InvokeAsync(StateHasChanged);
    }

    public ValueTask DisposeAsync()
    {
        _disposeToken.Cancel();
        _disposeToken.Dispose();
        return ValueTask.CompletedTask;
    }
}
