<!DOCTYPE html>
<html lang="en"
      data-opx-theme-mode="@DisplayOptions.DefaultThemeMode"
      data-opx-theme-storage-key="@DisplayOptions.StorageKey"
      data-opx-use-app-font-size="@DisplayOptions.UseAppFontSize.ToString().ToLowerInvariant()"
      data-opx-font-size="@DisplayOptions.DefaultFontSizePx.ToString(System.Globalization.CultureInfo.InvariantCulture)"
      data-opx-minimum-font-size="@DisplayOptions.MinimumFontSizePx.ToString(System.Globalization.CultureInfo.InvariantCulture)"
      data-opx-maximum-font-size="@DisplayOptions.MaximumFontSizePx.ToString(System.Globalization.CultureInfo.InvariantCulture)"
      data-opx-density="@DisplayOptions.DefaultDensity">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="@ApplicationOptions.ResolvedAuthor" />
    <title>@ApplicationOptions.ResolvedAppName</title>
    <base href="/" />
    <ResourcePreloader />
    <script src="@Assets["_content/Opx.MudBlazor.FlatUi/opx-flat-ui-theme-bootstrap.js"]"></script>
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Opx.MudBlazor.FlatUi/opx-flat-ui.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Opx.MudBlazor.FlatUi.Showcase/opx-flat-ui-showcase.css"]" />
    <link rel="stylesheet" href="@Assets["Opx.MudBlazor.FlatUi.Sample.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    @((MarkupString)"<!-- Powered by opx (github.com/opxw) -->")
    <RootStartupGate @rendermode="InteractiveServer" />
    <FlatReconnectModal Options="ReconnectOptions" />
    <div id="blazor-error-ui" class="opx-fatal-error" role="alert" aria-live="assertive" aria-atomic="true" data-nosnippet>
        <div class="opx-fatal-error-state">
            <svg class="opx-fatal-error-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M19.35 10.04A7.49 7.49 0 0 0 5.4 7.9 5.994 5.994 0 0 0 6 19h10.73l-2-2H6a4 4 0 0 1-.78-7.92l1.08-.22.35-1.05A5.5 5.5 0 0 1 17.74 9l.15 1.24 1.23.18A3.49 3.49 0 0 1 22 13.87c0 .75-.24 1.44-.64 2.01l1.43 1.43A5.46 5.46 0 0 0 24 13.87a5.5 5.5 0 0 0-4.65-5.43zM3.27 2 2 3.27l3.02 3.02A7.96 7.96 0 0 0 4 7.9l1.63 1.63A5.6 5.6 0 0 1 7.1 7.1l9.63 9.63L19 19l1.73 1.73L22 19.46 3.27 2z" />
            </svg>
            <div>
                <strong>Application unavailable</strong>
                <small>The app stopped unexpectedly. Restart to continue.</small>
            </div>
            <button type="button" class="reload" onclick="window.location.reload()">Restart</button>
        </div>
    </div>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets[FlatUiJavaScriptPath]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [Inject]
    private FlatReconnectOptions ReconnectOptions { get; set; } = new();

    [Inject]
    private FlatApplicationOptions ApplicationOptions { get; set; } = new();

    [Inject]
    private FlatUiDisplayOptions DisplayOptions { get; set; } = new();

    [Inject]
    private FlatAssetOptions AssetOptions { get; set; } = new();

#if DEBUG
    private const bool IsDebugBuild = true;
#else
    private const bool IsDebugBuild = false;
#endif

    private string FlatUiJavaScriptPath => AssetOptions.ResolveJavaScriptPath(IsDebugBuild);
}
