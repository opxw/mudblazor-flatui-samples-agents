<PageTitle>Development Rules - Opx MudBlazor Flat UI</PageTitle>

<FlatPage Kind="FlatPageKind.Module" UsePanel="false" PageCssClass="development-rules-page no-mobile-fab">
    <ChildContent>
        <section class="development-rules-intro" aria-labelledby="development-rules-heading">
            <span class="eyebrow">Source of truth</span>
            <h1 id="development-rules-heading">Build every page from the same contract</h1>
            <p>This showroom summarizes the repository rules and development skill. Read the canonical files before implementation, then use the matching sample page as executable reference.</p>
        </section>

        <div class="development-rules-grid">
            @RulePanel("1", "Resolve page identity", "Assign one unique PageId, route, PageTitle mapping, menu/search entry, and host-owned permission boundary. Use the canonical page registry before choosing an archetype.", "opx.page.<area>.<purpose>")
            @RulePanel("2", "Keep the AppBar authoritative", "Row one is AppName and row two is PageTitle. Do not repeat the page title or description in content unless the description is explicitly required. Keep the operational AppBar at 60px and center its 40px hamburger with equal 10px top and bottom space.", "AppName / PageTitle")
            @RulePanel("3", "Use responsive navigation deliberately", "Sidebar is the default. Horizontal is web-only; Bottom is phone-only. Bottom children use the configured Sheet default or Main View icon-and-text tiles, with recursive Back and safe-area gutters.", "Sidebar · Horizontal · Bottom")
            @RulePanel("4", "Compose grids from shared state", "Desktop tables and mobile cards share search, column filters, sort, paging, selection, and permissions. Filters open in a mobile sheet; bounded desktop grids own both scroll axes, while bounded Model CRUD cards own one internal vertical scroller with toolbar and pager fixed. An opt-in mobile edge status uses fixed responsive width and overlaps the card's top/right border by exactly one pixel. Mobile search toolbars place a transparent Apps/Close action-row toggle in the search placeholder area, vertically center its complete touch target against the search border box, and never resemble a combo-box chevron or overflow menu. Lookup grids use ASC/DESC-only headers, search the active sorted column, autofocus search, and route modal letter/number typing into it.", "One query state")
            @RulePanel("5", "Expose one primary action", "Writable CRUD uses one desktop Add button and one icon-only mobile FAB generated from the same FlatPage action. FAB shape comes from appsettings: Circle is default, Square is optional. Toolbar filter, refresh, import, export, and custom actions stay icon-only and configurable.", "FlatPage PrimaryAction")
            @RulePanel("6", "Honor CRUD result contracts", "Use Edit—not Ubah—for the CRUD edit action, editor title, tooltip, and accessible label. Mobile editors are fullscreen. A dirty Back or Cancel opens the shared locked MessageBox; discard closes only the top modal and returns false without reload, while continue editing preserves the draft. Successful Create, Update, or Delete returns the exact result and may refresh the caller.", "Edit · Cancel = no refresh")
            @RulePanel("7", "Use theme-safe flat geometry", "All surfaces stay square by default. Only buttons and bottom sheets may use the global Rounded size setting (0-12 px, default 0); semantic circles and FAB shape remain separate contracts. The built-in TRUST palette resolves Primary #1e3799 through shared typed tokens, never page-local CSS.", "DefaultRoundedSizePx: 0")
            @RulePanel("8", "Adapt instead of shrinking desktop", "Keep one Blazor codebase and one OPX design system, but transform navigation, hierarchy, forms, actions, and data presentation by viewport. Preserve the 900px table/card boundary, 600px phone refinement, device/browser 1rem default, optional 16px Manual baseline, shared tokens, and high-density touch settings; never choose layout typography from Android/iOS detection.", "Desktop > 900 · Responsive <= 900")
            @RulePanel("9", "Keep typography and spacing coherent", "Font ownership defaults to Device/browser root size, but Settings always lets users persist Device or Manual. Manual reveals the bounded font slider; Device hides it without losing its last value. Appsettings supplies Restore defaults, not a UI lock. Settings/About headers and footers never shrink; the body alone scrolls. Shared panel title/subtitle pairs use a compact 3px gap. Numeric values use one compact monospace token with tabular digits; mobile-card fact values stay normal weight. Font size and density remain independent.", "Device / Manual · Responsive tokens")
            @RulePanel("10", "Leave business ownership to the host", "The library owns presentation and typed callbacks. The host owns API calls, authorization, persistence, validation, concurrency, audit, upload storage, realtime/device integration, GPS, geocoding, and routing engines.", "Host-owned effects")
            @RulePanel("11", "Verify before release", "Run unit and component tests, desktop/responsive/phone live-resize checks, Light/Dark/Auto and accessibility checks, public API compatibility, Release build, package-content inspection, and fresh-consumer restore before publishing.", "Evidence before claims")
            @RulePanel("12", "Keep spatial state controlled", "Layered floors, geofences, work-list selection, viewport, and route playback use typed host-controlled state. Mobile stacks the list and map without page overflow; GPS, routing, geofence evaluation, and telemetry remain host-owned.", "FlatSpatialWorkspace")
            @RulePanel("13", "Use the global application foundation", "Protect unsaved drafts, express permission and feature visibility, normalize operation failures and server queries, persist workspace state through host providers, and keep session, telemetry, and accessibility intents explicit. Use FlatSessionRestore so session bootstrap and Reconnecting share one system spinner; session validation remains host-owned.", "Host-owned global contracts")
            @RulePanel("14", "Reuse the Material icon picker", "Use FlatMaterialIconPicker for Filled and Outlined MudBlazor icons. Keep search and paging inside the shared responsive modal, and persist the stable icon name plus style instead of copying SVG values into business data.", "FlatMaterialIconPicker")
            @RulePanel("15", "Lock the consumer baseline", "Create NuGet-only Web consumers from the opx-flatui-web template with OPX 2.0.11 and MudBlazor 9.7.0. Clean project-local bin/obj before first restore/run, load reusable CSS only from package assets, keep Light default, Device/Manual font ownership, runtime OPX attribution, Settings, searchable sidebar, adaptive responsive rules, canonical Edit terminology, and host-owned business data.", "Schema 2.5 · Package 2.0.11")
            @RulePanel("16", "Honor the native mobile host", "Android/iOS MAUI hosts start typography in Device mode, including text-button labels and content-fit button sizing that grows or wraps without clipping while preserving the minimum touch target. Use CommunityToolkit.Maui and register UseMauiCommunityToolkit. Bind Toolkit StatusBarBehavior to the exact resolved AppBar theme token. Keep normal scroll but disable WebView bounce/edge overscroll; make ordinary UI text non-selectable while preserving selection, caret, and clipboard in textbox-class inputs and editors. Verify all native behavior on both platforms.", "No bounce · Selection only in textbox")
            @RulePanel("17", "Gate protected startup", "On MAUI, Memuat always includes the same package spinner used by Reconnecting, beginning in static BlazorWebView host markup and continuing through FlatSessionRestore Title=Memuat without blank or duplicate states. When authentication is enabled, render FlatSessionRestore alone during the single-flight host validation. Never flash MainLayout before validation; invalid or failed state clears stale data and opens Login.", "Memuat + spinner · Checking → MainLayout/Login")
        </div>

        <FlatPanel Title="Canonical development path" Subtitle="Follow this order for every new or revised page" CssClass="flat-panel development-rules-flow">
            <ol>
                <li><strong>Read</strong><span><code>RULES.md</code>, <code>.agents/RULES.md</code>, and the development skill.</span></li>
                <li><strong>Resolve</strong><span>Find the PageId and archetype in <code>page-registry.md</code>.</span></li>
                <li><strong>Reuse</strong><span>Open only the relevant files listed by <code>sample-source-map.md</code>.</span></li>
                <li><strong>Implement</strong><span>Prefer package components and shared state instead of page-local behavior.</span></li>
                <li><strong>Verify</strong><span>Test Light/Dark/Auto, desktop/mobile, live resize, keyboard, overflow, and host callbacks.</span></li>
                <li><strong>Synchronize</strong><span>Update rules, skill references, documentation, sample, tests, and handoff when the contract changes.</span></li>
            </ol>
        </FlatPanel>
    </ChildContent>
</FlatPage>

@code {
    private static RenderFragment RulePanel(string number, string title, string copy, string contract) => @<article class="development-rule-card">
        <span class="development-rule-number">@number</span>
        <div>
            <h2>@title</h2>
            <p>@copy</p>
            <code>@contract</code>
        </div>
    </article>;
}
