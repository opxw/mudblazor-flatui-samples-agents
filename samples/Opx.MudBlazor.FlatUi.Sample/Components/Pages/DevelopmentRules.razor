<PageTitle>Development Rules - Opx MudBlazor Flat UI</PageTitle>

<FlatPage Kind="FlatPageKind.Module" UsePanel="false" PageCssClass="development-rules-page no-mobile-fab">
    <ChildContent>
        <section class="development-rules-intro" aria-labelledby="development-rules-heading">
            <span class="eyebrow">Source of truth</span>
            <h1 id="development-rules-heading">Build every page from the same contract</h1>
            <p>This showroom summarizes the repository rules and development skill. Read the canonical files before implementation, then use the matching sample page as executable reference.</p>
        </section>

        <div class="development-rules-grid">
            @RulePanel("1", "Resolve page identity", "Assign one unique PageId, route, PageTitle mapping, menu/search entry, and host-owned permission boundary. Use the canonical page registry before choosing an archetype.", "opx.page.<area>.<purpose>")
            @RulePanel("2", "Keep the AppBar authoritative", "Row one is AppName and row two is PageTitle. Do not repeat the page title or description in content unless the description is explicitly required. Keep the operational AppBar at 60px and center its 40px hamburger with equal 10px top and bottom space.", "AppName / PageTitle")
            @RulePanel("3", "Use responsive navigation deliberately", "Sidebar is the default. Horizontal is web-only; Bottom is phone-only. Bottom children use the configured Sheet default or Main View icon-and-text tiles, with recursive Back and safe-area gutters.", "Sidebar · Horizontal · Bottom")
            @RulePanel("4", "Compose grids from shared state", "Desktop tables and mobile cards share search, column filters, sort, paging, selection, and permissions. Filters open in a mobile sheet; bounded desktop grids own both scroll axes, while bounded Model CRUD cards own one internal vertical scroller with toolbar and pager fixed. Mobile search toolbars place a transparent Apps/Close action-row toggle in the search placeholder area, never a combo-box chevron or overflow menu. Lookup grids use ASC/DESC-only headers, search the active sorted column, autofocus search, and route modal letter/number typing into it.", "One query state")
            @RulePanel("5", "Expose one primary action", "Writable CRUD uses one desktop Add button and one icon-only mobile FAB generated from the same FlatPage action. FAB shape comes from appsettings: Circle is default, Square is optional. Toolbar filter, refresh, import, export, and custom actions stay icon-only and configurable.", "FlatPage PrimaryAction")
            @RulePanel("6", "Honor CRUD result contracts", "Mobile editors are fullscreen. A dirty Back or Cancel opens the shared locked MessageBox; discard closes only the top modal and returns false without reload, while continue editing preserves the draft. Successful Create, Update, or Delete returns the exact result and may refresh the caller.", "Cancel = no refresh")
            @RulePanel("7", "Use theme-safe flat geometry", "All surfaces stay square by default. Only buttons and bottom sheets may use the global Rounded size setting (0-12 px, default 0); semantic circles and FAB shape remain separate contracts.", "DefaultRoundedSizePx: 0")
            @RulePanel("8", "Keep typography and spacing coherent", "Font size and density are independent settings. Mobile outer gutters are 16px. Widget grids own their 12px desktop or 10px mobile gap; widgets keep zero outer margin and the package-defined header, body, footer, and variant padding so nested spacing is never doubled. Eligible pull-to-refresh pages reuse the shared native-style circular arrow and refresh arc.", "Widget spacing · Responsive tokens")
            @RulePanel("9", "Leave business ownership to the host", "The library owns presentation and typed callbacks. The host owns API calls, authorization, persistence, validation, concurrency, audit, upload storage, realtime/device integration, GPS, geocoding, and routing engines.", "Host-owned effects")
            @RulePanel("10", "Verify before release", "Run unit and component tests, responsive Playwright, accessibility checks, public API compatibility, Release build, package-content inspection, and fresh-consumer restore before publishing.", "Evidence before claims")
            @RulePanel("11", "Keep spatial state controlled", "Layered floors, geofences, work-list selection, viewport, and route playback use typed host-controlled state. Mobile stacks the list and map without page overflow; GPS, routing, geofence evaluation, and telemetry remain host-owned.", "FlatSpatialWorkspace")
            @RulePanel("12", "Use the global application foundation", "Protect unsaved drafts, express permission and feature visibility, normalize operation failures and server queries, persist workspace state through host providers, and keep session, telemetry, and accessibility intents explicit.", "Host-owned global contracts")
            @RulePanel("13", "Lock the consumer baseline", "Create NuGet-only Web consumers from the opx-flatui-web template. Keep the contract manifest, exact package versions, PageId/archetype, host registrations, asset order, Light default theme, AppBar Settings modal, searchable default sidebar, display defaults, rules, and skill together. Dashboard records, user summaries, current-user identity, logout/session behavior, and business menu records stay consumer-owned.", "Settings + Sidebar; domain data outside")
        </div>

        <FlatPanel Title="Canonical development path" Subtitle="Follow this order for every new or revised page" CssClass="flat-panel development-rules-flow">
            <ol>
                <li><strong>Read</strong><span><code>RULES.md</code>, <code>.agents/RULES.md</code>, and the development skill.</span></li>
                <li><strong>Resolve</strong><span>Find the PageId and archetype in <code>page-registry.md</code>.</span></li>
                <li><strong>Reuse</strong><span>Open only the relevant files listed by <code>sample-source-map.md</code>.</span></li>
                <li><strong>Implement</strong><span>Prefer package components and shared state instead of page-local behavior.</span></li>
                <li><strong>Verify</strong><span>Test Light/Dark/Auto, desktop/mobile, live resize, keyboard, overflow, and host callbacks.</span></li>
                <li><strong>Audit</strong><span>Run <code>audit_flat_ui_consumer.ps1</code> for NuGet consumers before the Release build.</span></li>
                <li><strong>Synchronize</strong><span>Update rules, skill references, documentation, sample, tests, and handoff when the contract changes.</span></li>
            </ol>
        </FlatPanel>
    </ChildContent>
</FlatPage>

@code {
    private static RenderFragment RulePanel(string number, string title, string copy, string contract) => @<article class="development-rule-card">
        <span class="development-rule-number">@number</span>
        <div>
            <h2>@title</h2>
            <p>@copy</p>
            <code>@contract</code>
        </div>
    </article>;
}
