@page "/reset-password"
@layout AuthLayout
@inject NavigationManager Navigation

<PageTitle>Reset Password - Opx MudBlazor Flat UI</PageTitle>

<section class="verification-page reset-password-page">
    <MudPaper Class="verification-card reset-password-card" Elevation="0">
        <div class="verification-icon" aria-hidden="true">
            <MudIcon Icon="@Icons.Material.Outlined.Password" />
        </div>

        <div class="verification-heading">
            <span class="login-eyebrow">Account recovery</span>
            <h1>Reset password</h1>
            @if (_stage == ResetStage.Request)
            {
                <p>Enter the email associated with your account. We will show the reset-code step next.</p>
            }
            else if (_stage == ResetStage.Reset)
            {
                <p>Enter the code sent to <strong>@MaskedEmail</strong>, then create a new password.</p>
            }
            else
            {
                <p>Your sample password has been updated. Continue to the login page.</p>
            }
        </div>

        @if (_stage == ResetStage.Request)
        {
            <EditForm Model="this" OnValidSubmit="RequestReset">
                <div class="reset-password-form">
                    <MudTextField T="string"
                                  Label="Email address"
                                  Variant="Variant.Outlined"
                                  InputType="InputType.Email"
                                  @bind-Value="_email"
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Outlined.Email"
                                  HelperText="Use the email registered to the consumer application." />
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Disabled="@(!EmailReady)"
                               StartIcon="@Icons.Material.Outlined.Send">
                        Send reset code
                    </MudButton>
                </div>
            </EditForm>
        }
        else if (_stage == ResetStage.Reset)
        {
            <EditForm Model="this" OnValidSubmit="ResetPasswordAsync">
                <div class="reset-password-form">
                    <MudTextField T="string"
                                  Label="Reset code"
                                  Variant="Variant.Outlined"
                                  @bind-Value="ResetCode"
                                  Immediate="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Outlined.Pin"
                                  HelperText="Enter the six-digit temporary code." />
                    <MudTextField T="string"
                                  Class="opx-password-visibility-field"
                                  Label="New password"
                                  Variant="Variant.Outlined"
                                  @bind-Value="_newPassword"
                                  Immediate="true"
                                  InputType="@(_showPasswords ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPasswords ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                                  AdornmentAriaLabel="@(_showPasswords ? "Hide passwords" : "Show passwords")"
                                  OnAdornmentClick="TogglePasswords" />
                    <MudTextField T="string"
                                  Class="opx-password-visibility-field"
                                  Label="Confirm new password"
                                  Variant="Variant.Outlined"
                                  @bind-Value="_confirmPassword"
                                  Immediate="true"
                                  InputType="@(_showPasswords ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPasswords ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                                  AdornmentAriaLabel="@(_showPasswords ? "Hide passwords" : "Show passwords")"
                                  OnAdornmentClick="TogglePasswords"
                                  Error="@PasswordMismatch"
                                  ErrorText="Passwords do not match." />

                    <div class="password-requirements" aria-label="Password requirements">
                        <span class="@(PasswordLengthValid ? "valid" : "")">
                            <MudIcon Icon="@(PasswordLengthValid ? Icons.Material.Outlined.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)" Size="Size.Small" />
                            At least 8 characters
                        </span>
                        <span class="@(PasswordNumberValid ? "valid" : "")">
                            <MudIcon Icon="@(PasswordNumberValid ? Icons.Material.Outlined.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)" Size="Size.Small" />
                            Contains a number
                        </span>
                        <span class="@(PasswordsMatch ? "valid" : "")">
                            <MudIcon Icon="@(PasswordsMatch ? Icons.Material.Outlined.CheckCircle : Icons.Material.Outlined.RadioButtonUnchecked)" Size="Size.Small" />
                            Passwords match
                        </span>
                    </div>

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               FullWidth="true"
                               Disabled="@(!CanResetPassword)"
                               StartIcon="@Icons.Material.Outlined.LockReset">
                        Reset password
                    </MudButton>
                </div>
            </EditForm>

            <div class="verification-resend">
                <span>Wrong email?</span>
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="UseAnotherEmail">Use another email</MudButton>
            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">
                Sample password reset completed. No credential was changed on a server.
            </MudAlert>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Class="reset-login-button"
                       StartIcon="@Icons.Material.Outlined.Login"
                       OnClick="BackToLogin">
                Continue to login
            </MudButton>
        }

        @if (_stage != ResetStage.Success)
        {
            <MudButton Variant="Variant.Text"
                       FullWidth="true"
                       StartIcon="@Icons.Material.Outlined.ArrowBack"
                       OnClick="BackToLogin">
                Back to login
            </MudButton>
        }

        <div class="login-demo-note">
            <strong>Sample only</strong>
            <span>No email, reset code, password, or session is sent to a backend. The consumer must implement secure recovery and token validation.</span>
        </div>
    </MudPaper>
</section>

@code {
    private string _email = "operator@example.com";
    private string _resetCode = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private bool _showPasswords;
    private ResetStage _stage;

    private string ResetCode
    {
        get => _resetCode;
        set => _resetCode = new string((value ?? "").Where(char.IsDigit).Take(6).ToArray());
    }

    private bool EmailReady => _email.Contains('@') && _email.Contains('.') && _email.Length >= 5;
    private bool PasswordLengthValid => _newPassword.Length >= 8;
    private bool PasswordNumberValid => _newPassword.Any(char.IsDigit);
    private bool PasswordsMatch => _newPassword.Length > 0 && _newPassword == _confirmPassword;
    private bool PasswordMismatch => _confirmPassword.Length > 0 && !PasswordsMatch;
    private bool CanResetPassword => ResetCode.Length == 6 && PasswordLengthValid && PasswordNumberValid && PasswordsMatch;
    private string MaskedEmail => MaskEmail(_email);

    private void RequestReset()
    {
        if (EmailReady)
        {
            _stage = ResetStage.Reset;
        }
    }

    private async Task ResetPasswordAsync()
    {
        if (!CanResetPassword)
        {
            return;
        }

        await Task.Yield();
        _resetCode = "";
        _newPassword = "";
        _confirmPassword = "";
        _stage = ResetStage.Success;
    }

    private void UseAnotherEmail()
    {
        _resetCode = "";
        _newPassword = "";
        _confirmPassword = "";
        _stage = ResetStage.Request;
    }

    private void TogglePasswords() => _showPasswords = !_showPasswords;
    private void BackToLogin() => Navigation.NavigateTo("/login");

    private static string MaskEmail(string email)
    {
        var parts = email.Split('@', 2);
        if (parts.Length != 2 || parts[0].Length == 0)
        {
            return "your email";
        }

        return $"{parts[0][0]}***@{parts[1]}";
    }

    private enum ResetStage
    {
        Request,
        Reset,
        Success
    }
}
