{
  "$schema": "flat-ui.contract.schema.json",
  "schemaVersion": "3.1",
  "contractVersion": "2.1.29",
  "source": {
    "repository": "mudblazor-flat-ui",
    "samplePath": "samples/Opx.MudBlazor.FlatUi.Showcase"
  },
  "packages": {
    "Opx.MudBlazor.FlatUi": "2.1.29",
    "MudBlazor": "9.9.0"
  },
  "canonicalSample": {
    "mode": "exact-initial-baseline",
    "auditSwitch": "-ExactSample",
    "lineEndingNormalization": "LF",
    "promptTriggers": ["sama", "persis", "canonical", "seperti sample", "source of truth"],
    "files": {
      "Components/Layout/MainLayout.razor": "6DEE59C280F9E1345DB1592D1E08FAF7FBDA96A28CBFABDBC38509F6DCE07C19",
      "../Opx.MudBlazor.FlatUi.Showcase/ShowcaseNavigationCatalog.cs": "6011B13E06F70D3ABCA101FC8D42CB826CD86468A8C4980097D5FE3A41388875",
      "../Opx.MudBlazor.FlatUi.Showcase/Components/Pages/Home.razor": "78C721DCBD7F30FD6AB6F6D2CAB8683D4940DB395B15239B9215F32AC3A24032",
      "Components/RootStartupGate.razor": "73F8016F245BE7D55C5103677B28F7927EBDC069E39BF22BC49A542CDAD18A7F",
      "appsettings.json": "B733311902471049360932C69746400DD7E09EDA6A25BD990577561811C277AD",
      "../Opx.MudBlazor.FlatUi.Showcase/wwwroot/opx-flat-ui-showcase.css": "3BCB8DDE3956E3ACEF5CD91C779882222871DB6BA53F48D9237CC70F2E5C18F7"
    },
    "allowedAfterBaseline": ["branding", "wording", "data", "authorization", "callbacks", "domain-integration", "persistence"],
    "visualDriftRequiresExplicitDecision": true
  },
  "baseline": {
    "pageId": "opx.page.dashboard.overview",
    "route": "/",
    "archetype": "Home.razor",
    "useAppFontSize": false,
    "baseFontSizePx": 16,
    "panelHeaderMinHeightPx": 48,
    "panelHeaderPaddingYPx": 10,
    "defaultRoundedSizePx": 7,
    "defaultColorPalette": "fluent-blue",
    "defaultDensity": "Default",
    "defaultBottomNavigationChildPresentation": "Sheet",
    "responsiveBreakpointPx": 900,
    "adaptiveResponsive": {
      "desktopTableAbovePx": 900,
      "responsiveCardMaxPx": 900,
      "twoColumnCardMinPx": 601,
      "twoColumnCardMaxPx": 900,
      "phoneSingleColumnMaxPx": 600,
      "bottomNavigationDefaultMaxWidthPx": 600,
      "bottomNavigationSampleMaxWidthPx": 900,
      "bottomNavigationViewportOnly": true,
      "bottomNavigationBarHeightPx": 60,
      "bottomNavigationLabelLineHeight": 1.25,
      "bottomNavigationLabelBottomInsetPx": 1,
      "bottomNavigationDescendersVisible": true,
      "mobileToolbarActionsExpandedByDefault": false,
      "liveResizeRequired": true,
      "platformUserAgentLayoutForbidden": true
    },
    "nativeMobileDeployment": {
      "appliesWhen": "maui-android-ios-host-present",
      "platforms": ["Android", "iOS"],
      "toolkitPackage": "CommunityToolkit.Maui",
      "builderRegistration": "UseMauiCommunityToolkit",
      "typography": {
        "fontOwnership": "Device",
        "useAppFontSize": false,
        "rootFontSource": "device-browser-1rem",
        "accessibilityScalingPreserved": true,
        "buttonSizing": {
          "labelFollowsDeviceFontScale": true,
          "containerGrowsWithScaledText": true,
          "inlineSizeAccommodatesScaledLabel": true,
          "minimumTouchTargetPreserved": true,
          "textClippingForbidden": true,
          "fixedHeightAtAccessibilityScaleForbidden": true
        }
      },
      "statusBar": {
        "toolkitApi": "StatusBarBehavior",
        "colorContract": "same-resolved-appbar-background",
        "colorSource": "resolved-appbar-theme-token",
        "synchronizedThemeModes": ["Light", "Dark / Night", "Auto"],
        "updateTriggers": ["startup", "theme-change", "palette-change", "navigation", "resume"],
        "followsResolvedUiTheme": true,
        "followsResolvedAppBarColor": true,
        "syncOnThemeOrPaletteChange": true,
        "contrastAwareContentStyle": true,
        "iosViewControllerBasedStatusBarAppearance": false,
        "nativeVerificationRequired": true
      },
      "startupLoading": {
        "appliesDuring": ["blazor-webview-bootstrap", "session-authorization-check"],
        "displayText": "Memuat",
        "spinnerRequired": true,
        "spinnerCssClass": "flat-system-loading-spinner",
        "visualReference": "FlatReconnectModal.Reconnecting",
        "textOnlyForbidden": true,
        "singleSystemLoadingVisual": true,
        "staticHostMarkupRequiredBeforeRazorInteractive": true,
        "fullViewport": true,
        "centered": true,
        "themeAware": true,
        "safeAreaAware": true,
        "reducedMotionFallbackVisible": true,
        "protectedLayoutBeforeCompletionForbidden": true
      },
      "webViewInteraction": {
        "ordinaryScrollingPreserved": true,
        "rootBounceForbidden": true,
        "documentOverscrollBehavior": "none",
        "iosScrollViewBounces": false,
        "iosAlwaysBounceVertical": false,
        "androidOverScrollMode": "Never",
        "pullToRefreshRequiresDedicatedControl": true,
        "backNavigation": {
          "precedence": ["topmost-modal-overlay", "previous-blazor-history", "native-host-fallback"],
          "modalBackKeepsCurrentRoute": true,
          "modalBackKeepsApplicationAlive": true,
          "nativeExitRequiresEmptyOverlayAndHistory": true
        },
        "textSelection": {
          "defaultPolicy": "disabled",
          "allowedTargets": ["input-text", "textarea", "contenteditable"],
          "allowedUserSelect": "text",
          "outsideAllowedTargetsUserSelect": "none",
          "touchCalloutOutsideAllowedTargetsForbidden": true,
          "caretAndClipboardPreservedForAllowedTargets": true
        }
      }
    },
    "startupAccessGate": {
      "appliesWhen": "host-authentication-enabled",
      "placement": "root-before-router",
      "rootComponent": "RootStartupGate",
      "loadingProvider": "FlatMudProviders",
      "loadingProviderPlacement": "checking-branch-before-router",
      "nestedLoadingProviderForbidden": true,
      "routerCreationBeforeCompletionForbidden": true,
      "runsForAnonymousRoutes": true,
      "loadingTitle": "Memuat halaman",
      "loadingTitleSource": "OpxFlatUi:Reconnect:StartupTitle",
      "loadingMessageSource": "OpxFlatUi:Reconnect:StartupMessage",
      "loadingVisualReference": "FlatReconnectModal.Reconnecting",
      "preferencesInitializedBeforeValidation": true,
      "resolvedThemeProviderBeforeValidation": true,
      "preloaderComponent": "FlatSessionRestore",
      "storageHint": "local-storage",
      "localStorageIsAuthorizationAuthority": false,
      "hostValidationRequired": true,
      "backendAuthorizationEnforcementRequired": true,
      "protectedLayoutBeforeValidationForbidden": true,
      "singleFlight": true,
      "states": {
        "checking": "FlatSessionRestore",
        "valid": "MainLayout",
        "invalid": "Login",
        "error": "Login"
      },
      "authenticationStateUpdatedBeforeMainLayout": true,
      "staleSessionClearedOnInvalid": true
    },
    "defaultThemeMode": "Light",
    "appBarSearchVisible": true,
    "crudTerminology": {
      "editActionLabel": "Edit"
    },
    "runtimeHtml": {
      "poweredByComment": "Powered by opx (github.com/opxw)"
    },
    "initialRun": {
      "script": "run-clean.ps1",
      "cleanDirectories": ["bin", "obj"],
      "restoreBeforeRun": true
    },
    "stylesheetOwnership": {
      "reusableCssSource": "package-only",
      "packageStylesheet": "_content/Opx.MudBlazor.FlatUi/opx-flat-ui.css",
      "packageStylesheetSha256": "EFBBB7475A05C6ED0B82CDC380E6DC36F374E8879CABAFF9F94899C40009C684",
      "mudBlazorStylesheet": "_content/MudBlazor/MudBlazor.min.css",
      "hostStylesheet": "../Opx.MudBlazor.FlatUi.Showcase/wwwroot/opx-flat-ui-showcase.css",
      "hostStylesheetPurpose": "sample-and-domain-composition-only",
      "hostStylesheetSha256": "3BCB8DDE3956E3ACEF5CD91C779882222871DB6BA53F48D9237CC70F2E5C18F7",
      "localPackageCssCopyForbidden": true,
      "additionalUiFrameworkCssForbidden": true
    },
    "mandatoryShell": {
      "layoutSource": "Components/Layout/MainLayout.razor",
      "settings": {
        "required": true,
        "triggerIcon": "MoreVert",
        "menuLabel": "Settings",
        "modalTitle": "Application preferences",
        "themeModes": ["Light", "Dark / Night", "Auto"]
      },
      "sidebar": {
        "required": true,
        "componentSource": "Components/Layout/SampleSidebarMenu.razor",
        "caption": "Showcase",
        "homeLabel": "Dashboard",
        "homeRoute": "/",
        "initialGroups": ["ERP", "Operations", "Data & Reports", "Commerce & Content", "Account", "UI Kit"],
        "searchEnabled": true,
        "activeRouteExpansion": true
      }
    },
    "consumerOwnedSurfaces": [
      "dashboard-domain-content",
      "domain-widgets-and-metrics",
      "domain-summary-lists",
      "quick-access-actions",
      "current-user-identity",
      "role-and-account-copy",
      "logout-and-session-behavior",
      "business-menu-labels-routes-and-permissions"
    ],
    "widgetSpacing": {
      "outerMarginPx": 0,
      "gridGapPx": {
        "desktop": 12,
        "mobile": 10
      },
      "bodyPaddingPx": 12,
      "headerPaddingPx": {
        "block": 9,
        "inline": 12
      },
      "footerPaddingPx": {
        "block": 8,
        "inline": 12
      },
      "sectionGapPx": {
        "desktop": 18,
        "mobile": 16
      },
      "sectionHeadingBottomMarginPx": 8,
      "actionMetricPaddingPx": {
        "desktop": 13,
        "mobile": 12
      },
      "compactMetricPaddingPx": 13,
      "lowerGridTopMarginPx": {
        "desktop": 12,
        "mobile": 10
      },
      "mobileBreakpointPx": 600
    },
    "allowedAdaptations": [
      "branding",
      "wording",
      "data",
      "authorization",
      "domain-integration"
    ]
  }
}
