              "type": "object",
              "additionalProperties": false,
              "required": [
                "appliesDuring",
                "displayText",
                "spinnerRequired",
                "spinnerCssClass",
                "visualReference",
                "textOnlyForbidden",
                "singleSystemLoadingVisual",
                "staticHostMarkupRequiredBeforeRazorInteractive",
                "fullViewport",
                "centered",
                "themeAware",
                "safeAreaAware",
                "reducedMotionFallbackVisible",
                "protectedLayoutBeforeCompletionForbidden"
