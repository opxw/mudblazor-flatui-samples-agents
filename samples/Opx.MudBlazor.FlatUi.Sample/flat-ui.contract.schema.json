{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opx.local/schemas/flat-ui.contract.schema.json",
  "title": "OPX Flat UI consumer contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "source",
    "packages",
    "canonicalSample",
    "baseline"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "3.1"
    },
    "contractVersion": {
      "const": "2.0.17"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "samplePath"],
      "properties": {
        "repository": {
          "const": "mudblazor-flat-ui"
        },
        "samplePath": {
          "const": "samples/Opx.MudBlazor.FlatUi.Sample"
        }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Opx.MudBlazor.FlatUi", "MudBlazor"],
      "properties": {
        "Opx.MudBlazor.FlatUi": {
          "const": "2.0.17"
        },
        "MudBlazor": {
          "const": "9.8.0"
        }
      }
    },
    "canonicalSample": {
      "const": {
        "mode": "exact-initial-baseline",
        "auditSwitch": "-ExactSample",
        "lineEndingNormalization": "LF",
        "promptTriggers": ["sama", "persis", "canonical", "seperti sample", "source of truth"],
        "files": {
          "Components/Layout/MainLayout.razor": "1329B9F7A058128B3971CA6C76FD4CCB06333CA9D7C17A2733D07109E46328A8",
          "Components/Layout/SampleSidebarMenu.razor": "8157F2819E65D521AFB4C49BF6D2C4C4BE423C7FBBF1DF26CC7139EBB0FDA5AB",
          "Components/Pages/Home.razor": "9303D93EAC12EAC1EB81CC2057E3283896C190086DBD7057BBBB07674CFA4440",
          "Components/RootStartupGate.razor": "1513F7901D638CFAA829E6B55EE623B5D9A42D8C0D1AE80FE9C130C5DCB78D1D",
          "appsettings.json": "1465D5A8931899ACDD96D7EB4C66EB9F08415267B7F35495E6D7615B557C8C9C",
          "wwwroot/app.css": "EDF51498287AA77C650FCC86D5E6F9DCC0FFC56D02B222FCDE51EFE977720666"
        },
        "allowedAfterBaseline": ["branding", "wording", "data", "authorization", "callbacks", "domain-integration", "persistence"],
        "visualDriftRequiresExplicitDecision": true
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageId",
        "route",
        "archetype",
        "useAppFontSize",
        "baseFontSizePx",
        "responsiveBreakpointPx",
        "adaptiveResponsive",
        "nativeMobileDeployment",
        "startupAccessGate",
        "defaultThemeMode",
        "crudTerminology",
        "runtimeHtml",
        "initialRun",
        "stylesheetOwnership",
        "mandatoryShell",
        "consumerOwnedSurfaces",
        "widgetSpacing",
        "allowedAdaptations"
      ],
      "properties": {
        "pageId": {
          "pattern": "^opx\\.page\\.[a-z0-9-]+(?:\\.[a-z0-9-]+)+$"
        },
        "route": {
          "type": "string",
          "pattern": "^/"
        },
        "archetype": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.razor$"
        },
        "useAppFontSize": {
          "const": false
        },
        "baseFontSizePx": {
          "const": 16
        },
        "responsiveBreakpointPx": {
          "const": 900
        },
        "adaptiveResponsive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "desktopTableAbovePx",
            "responsiveCardMaxPx",
            "twoColumnCardMinPx",
            "twoColumnCardMaxPx",
            "phoneSingleColumnMaxPx",
            "bottomNavigationDefaultMaxWidthPx",
            "bottomNavigationSampleMaxWidthPx",
            "bottomNavigationViewportOnly",
            "bottomNavigationBarHeightPx",
            "bottomNavigationLabelLineHeight",
            "bottomNavigationLabelBottomInsetPx",
            "bottomNavigationDescendersVisible",
            "liveResizeRequired",
            "platformUserAgentLayoutForbidden"
