{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opx.local/schemas/flat-ui.contract.schema.json",
  "title": "OPX Flat UI consumer contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractVersion",
    "source",
    "packages",
    "baseline"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "2.5"
    },
    "contractVersion": {
      "const": "2.0.11"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "samplePath"],
      "properties": {
        "repository": {
          "const": "mudblazor-flat-ui"
        },
        "samplePath": {
          "const": "samples/Opx.MudBlazor.FlatUi.Sample"
        }
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Opx.MudBlazor.FlatUi", "MudBlazor"],
      "properties": {
        "Opx.MudBlazor.FlatUi": {
          "const": "2.0.11"
        },
        "MudBlazor": {
          "const": "9.7.0"
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageId",
        "route",
        "archetype",
        "useAppFontSize",
        "baseFontSizePx",
        "responsiveBreakpointPx",
        "adaptiveResponsive",
        "nativeMobileDeployment",
        "startupAccessGate",
        "defaultThemeMode",
        "crudTerminology",
        "runtimeHtml",
        "initialRun",
        "stylesheetOwnership",
        "mandatoryShell",
        "consumerOwnedSurfaces",
        "widgetSpacing",
        "allowedAdaptations"
      ],
      "properties": {
        "pageId": {
          "pattern": "^opx\\.page\\.[a-z0-9-]+(?:\\.[a-z0-9-]+)+$"
        },
        "route": {
          "type": "string",
          "pattern": "^/"
        },
        "archetype": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.razor$"
        },
        "useAppFontSize": {
          "const": false
        },
        "baseFontSizePx": {
          "const": 16
        },
        "responsiveBreakpointPx": {
          "const": 900
        },
        "adaptiveResponsive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "desktopTableAbovePx",
            "responsiveCardMaxPx",
            "twoColumnCardMinPx",
            "twoColumnCardMaxPx",
            "phoneSingleColumnMaxPx",
            "liveResizeRequired",
            "platformUserAgentLayoutForbidden"
          ],
          "properties": {
            "desktopTableAbovePx": { "const": 900 },
            "responsiveCardMaxPx": { "const": 900 },
            "twoColumnCardMinPx": { "const": 601 },
            "twoColumnCardMaxPx": { "const": 900 },
            "phoneSingleColumnMaxPx": { "const": 600 },
            "liveResizeRequired": { "const": true },
            "platformUserAgentLayoutForbidden": { "const": true }
          }
        },
        "nativeMobileDeployment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "appliesWhen",
            "platforms",
            "toolkitPackage",
            "builderRegistration",
            "typography",
            "statusBar",
            "startupLoading",
            "webViewInteraction"
          ],
          "properties": {
            "appliesWhen": { "const": "maui-android-ios-host-present" },
            "platforms": { "const": ["Android", "iOS"] },
            "toolkitPackage": { "const": "CommunityToolkit.Maui" },
            "builderRegistration": { "const": "UseMauiCommunityToolkit" },
            "typography": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fontOwnership",
                "useAppFontSize",
                "rootFontSource",
                "accessibilityScalingPreserved",
                "buttonSizing"
              ],
              "properties": {
                "fontOwnership": { "const": "Device" },
                "useAppFontSize": { "const": false },
                "rootFontSource": { "const": "device-browser-1rem" },
                "accessibilityScalingPreserved": { "const": true },
                "buttonSizing": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "labelFollowsDeviceFontScale",
                    "containerGrowsWithScaledText",
                    "inlineSizeAccommodatesScaledLabel",
                    "minimumTouchTargetPreserved",
                    "textClippingForbidden",
                    "fixedHeightAtAccessibilityScaleForbidden"
                  ],
                  "properties": {
                    "labelFollowsDeviceFontScale": { "const": true },
                    "containerGrowsWithScaledText": { "const": true },
                    "inlineSizeAccommodatesScaledLabel": { "const": true },
                    "minimumTouchTargetPreserved": { "const": true },
                    "textClippingForbidden": { "const": true },
                    "fixedHeightAtAccessibilityScaleForbidden": { "const": true }
                  }
                }
              }
            },
            "statusBar": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "toolkitApi",
                "colorContract",
                "colorSource",
                "synchronizedThemeModes",
                "updateTriggers",
                "followsResolvedUiTheme",
                "followsResolvedAppBarColor",
                "syncOnThemeOrPaletteChange",
                "contrastAwareContentStyle",
                "iosViewControllerBasedStatusBarAppearance",
                "nativeVerificationRequired"
              ],
              "properties": {
                "toolkitApi": { "const": "StatusBarBehavior" },
                "colorContract": { "const": "same-resolved-appbar-background" },
                "colorSource": { "const": "resolved-appbar-theme-token" },
                "synchronizedThemeModes": { "const": ["Light", "Dark / Night", "Auto"] },
                "updateTriggers": { "const": ["startup", "theme-change", "palette-change", "navigation", "resume"] },
                "followsResolvedUiTheme": { "const": true },
                "followsResolvedAppBarColor": { "const": true },
                "syncOnThemeOrPaletteChange": { "const": true },
                "contrastAwareContentStyle": { "const": true },
                "iosViewControllerBasedStatusBarAppearance": { "const": false },
                "nativeVerificationRequired": { "const": true }
              }
            },
            "startupLoading": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "appliesDuring",
                "displayText",
                "spinnerRequired",
                "spinnerCssClass",
                "visualReference",
                "textOnlyForbidden",
                "singleSystemLoadingVisual",
                "staticHostMarkupRequiredBeforeRazorInteractive",
                "fullViewport",
                "centered",
                "themeAware",
                "safeAreaAware",
                "reducedMotionFallbackVisible",
                "protectedLayoutBeforeCompletionForbidden"
              ],
              "properties": {
                "appliesDuring": { "const": ["blazor-webview-bootstrap", "session-authorization-check"] },
                "displayText": { "const": "Memuat" },
                "spinnerRequired": { "const": true },
                "spinnerCssClass": { "const": "flat-system-loading-spinner" },
                "visualReference": { "const": "FlatReconnectModal.Reconnecting" },
                "textOnlyForbidden": { "const": true },
                "singleSystemLoadingVisual": { "const": true },
                "staticHostMarkupRequiredBeforeRazorInteractive": { "const": true },
                "fullViewport": { "const": true },
                "centered": { "const": true },
                "themeAware": { "const": true },
                "safeAreaAware": { "const": true },
                "reducedMotionFallbackVisible": { "const": true },
                "protectedLayoutBeforeCompletionForbidden": { "const": true }
              }
            },
            "webViewInteraction": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "ordinaryScrollingPreserved",
                "rootBounceForbidden",
                "documentOverscrollBehavior",
                "iosScrollViewBounces",
                "iosAlwaysBounceVertical",
                "androidOverScrollMode",
                "pullToRefreshRequiresDedicatedControl",
                "textSelection"
              ],
              "properties": {
                "ordinaryScrollingPreserved": { "const": true },
                "rootBounceForbidden": { "const": true },
                "documentOverscrollBehavior": { "const": "none" },
                "iosScrollViewBounces": { "const": false },
                "iosAlwaysBounceVertical": { "const": false },
                "androidOverScrollMode": { "const": "Never" },
                "pullToRefreshRequiresDedicatedControl": { "const": true },
                "textSelection": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "defaultPolicy",
                    "allowedTargets",
                    "allowedUserSelect",
                    "outsideAllowedTargetsUserSelect",
                    "touchCalloutOutsideAllowedTargetsForbidden",
                    "caretAndClipboardPreservedForAllowedTargets"
                  ],
                  "properties": {
                    "defaultPolicy": { "const": "disabled" },
                    "allowedTargets": { "const": ["input-text", "textarea", "contenteditable"] },
                    "allowedUserSelect": { "const": "text" },
                    "outsideAllowedTargetsUserSelect": { "const": "none" },
                    "touchCalloutOutsideAllowedTargetsForbidden": { "const": true },
                    "caretAndClipboardPreservedForAllowedTargets": { "const": true }
                  }
                }
              }
            }
          }
        },
        "startupAccessGate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "appliesWhen",
            "preloaderComponent",
            "storageHint",
            "localStorageIsAuthorizationAuthority",
            "hostValidationRequired",
            "backendAuthorizationEnforcementRequired",
            "protectedLayoutBeforeValidationForbidden",
            "singleFlight",
            "states",
            "authenticationStateUpdatedBeforeMainLayout",
            "staleSessionClearedOnInvalid"
          ],
          "properties": {
            "appliesWhen": { "const": "host-authentication-enabled" },
            "preloaderComponent": { "const": "FlatSessionRestore" },
            "storageHint": { "const": "local-storage" },
            "localStorageIsAuthorizationAuthority": { "const": false },
            "hostValidationRequired": { "const": true },
            "backendAuthorizationEnforcementRequired": { "const": true },
            "protectedLayoutBeforeValidationForbidden": { "const": true },
            "singleFlight": { "const": true },
            "states": {
              "type": "object",
              "additionalProperties": false,
              "required": ["checking", "valid", "invalid", "error"],
              "properties": {
                "checking": { "const": "FlatSessionRestore" },
                "valid": { "const": "MainLayout" },
                "invalid": { "const": "Login" },
                "error": { "const": "Login" }
              }
            },
            "authenticationStateUpdatedBeforeMainLayout": { "const": true },
            "staleSessionClearedOnInvalid": { "const": true }
          }
        },
        "defaultThemeMode": {
          "const": "Light"
        },
        "crudTerminology": {
          "type": "object",
          "additionalProperties": false,
          "required": ["editActionLabel"],
          "properties": {
            "editActionLabel": { "const": "Edit" }
          }
        },
        "runtimeHtml": {
          "type": "object",
          "additionalProperties": false,
          "required": ["poweredByComment"],
          "properties": {
            "poweredByComment": { "const": "Powered by opx (github.com/opxw)" }
          }
        },
        "initialRun": {
          "type": "object",
          "additionalProperties": false,
          "required": ["script", "cleanDirectories", "restoreBeforeRun"],
          "properties": {
            "script": { "const": "run-clean.ps1" },
            "cleanDirectories": { "const": ["bin", "obj"] },
            "restoreBeforeRun": { "const": true }
          }
        },
        "stylesheetOwnership": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reusableCssSource",
            "packageStylesheet",
            "packageStylesheetSha256",
            "mudBlazorStylesheet",
            "hostStylesheet",
            "hostStylesheetPurpose",
            "hostStylesheetSha256",
            "localPackageCssCopyForbidden",
            "additionalUiFrameworkCssForbidden"
          ],
          "properties": {
            "reusableCssSource": { "const": "package-only" },
            "packageStylesheet": { "const": "_content/Opx.MudBlazor.FlatUi/opx-flat-ui.css" },
            "packageStylesheetSha256": { "const": "7B710961C2B1C9E978003A5A88735B24A2CB7A68FFA4EC12AC17655183EC7026" },
            "mudBlazorStylesheet": { "const": "_content/MudBlazor/MudBlazor.min.css" },
            "hostStylesheet": { "const": "wwwroot/app.css" },
            "hostStylesheetPurpose": { "const": "sample-and-domain-composition-only" },
            "hostStylesheetSha256": { "const": "2857DD00F01305D6A573717A5793D272B882EE320752DD0207A562C41722D988" },
            "localPackageCssCopyForbidden": { "const": true },
            "additionalUiFrameworkCssForbidden": { "const": true }
          }
        },
        "mandatoryShell": {
          "type": "object",
          "additionalProperties": false,
          "required": ["layoutSource", "settings", "sidebar"],
          "properties": {
            "layoutSource": { "const": "Components/Layout/MainLayout.razor" },
            "settings": {
              "type": "object",
              "additionalProperties": false,
              "required": ["required", "triggerIcon", "menuLabel", "modalTitle", "themeModes"],
              "properties": {
                "required": { "const": true },
                "triggerIcon": { "const": "MoreVert" },
                "menuLabel": { "const": "Settings" },
                "modalTitle": { "const": "Application preferences" },
                "themeModes": { "const": ["Light", "Dark / Night", "Auto"] }
              }
            },
            "sidebar": {
              "type": "object",
              "additionalProperties": false,
              "required": ["required", "componentSource", "caption", "homeLabel", "homeRoute", "initialGroups", "searchEnabled", "activeRouteExpansion"],
              "properties": {
                "required": { "const": true },
                "componentSource": { "const": "Components/Layout/SampleSidebarMenu.razor" },
                "caption": { "const": "Showcase" },
                "homeLabel": { "const": "Dashboard" },
                "homeRoute": { "const": "/" },
                "initialGroups": { "const": ["ERP", "Operations", "Data & Reports", "Commerce & Content", "Account", "UI Kit"] },
                "searchEnabled": { "const": true },
                "activeRouteExpansion": { "const": true }
              }
            }
          }
        },
        "consumerOwnedSurfaces": {
          "const": [
            "dashboard-domain-content",
            "domain-widgets-and-metrics",
            "domain-summary-lists",
            "quick-access-actions",
            "current-user-identity",
            "role-and-account-copy",
            "logout-and-session-behavior",
            "business-menu-labels-routes-and-permissions"
          ]
        },
        "widgetSpacing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outerMarginPx",
            "gridGapPx",
            "bodyPaddingPx",
            "headerPaddingPx",
            "footerPaddingPx",
            "sectionGapPx",
            "sectionHeadingBottomMarginPx",
            "actionMetricPaddingPx",
            "compactMetricPaddingPx",
            "lowerGridTopMarginPx",
            "mobileBreakpointPx"
          ],
          "properties": {
            "outerMarginPx": { "const": 0 },
            "gridGapPx": {
              "type": "object",
              "additionalProperties": false,
              "required": ["desktop", "mobile"],
              "properties": {
                "desktop": { "const": 12 },
                "mobile": { "const": 10 }
              }
            },
            "bodyPaddingPx": { "const": 12 },
            "headerPaddingPx": {
              "type": "object",
              "additionalProperties": false,
              "required": ["block", "inline"],
              "properties": {
                "block": { "const": 9 },
                "inline": { "const": 12 }
              }
            },
            "footerPaddingPx": {
              "type": "object",
              "additionalProperties": false,
              "required": ["block", "inline"],
              "properties": {
                "block": { "const": 8 },
                "inline": { "const": 12 }
              }
            },
            "sectionGapPx": {
              "type": "object",
              "additionalProperties": false,
              "required": ["desktop", "mobile"],
              "properties": {
                "desktop": { "const": 18 },
                "mobile": { "const": 16 }
              }
            },
            "sectionHeadingBottomMarginPx": { "const": 8 },
            "actionMetricPaddingPx": {
              "type": "object",
              "additionalProperties": false,
              "required": ["desktop", "mobile"],
              "properties": {
                "desktop": { "const": 13 },
                "mobile": { "const": 12 }
              }
            },
            "compactMetricPaddingPx": { "const": 13 },
            "lowerGridTopMarginPx": {
              "type": "object",
              "additionalProperties": false,
              "required": ["desktop", "mobile"],
              "properties": {
                "desktop": { "const": 12 },
                "mobile": { "const": 10 }
              }
            },
            "mobileBreakpointPx": { "const": 600 }
          }
        },
        "allowedAdaptations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["branding", "wording", "data", "authorization", "domain-integration"]
          }
        }
      }
    }
  }
}
