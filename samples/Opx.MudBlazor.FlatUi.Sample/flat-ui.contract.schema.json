                    "touchCalloutOutsideAllowedTargetsForbidden": { "const": true },
                    "caretAndClipboardPreservedForAllowedTargets": { "const": true }
                  }
                }
              }
            }
          }
        },
        "startupAccessGate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "appliesWhen",
            "placement",
            "rootComponent",
            "loadingProvider",
            "loadingProviderPlacement",
            "nestedLoadingProviderForbidden",
            "routerCreationBeforeCompletionForbidden",
            "runsForAnonymousRoutes",
            "loadingTitle",
            "loadingTitleSource",
            "loadingMessageSource",
            "loadingVisualReference",
            "preferencesInitializedBeforeValidation",
            "resolvedThemeProviderBeforeValidation",
            "preloaderComponent",
            "storageHint",
            "localStorageIsAuthorizationAuthority",
            "hostValidationRequired",
            "backendAuthorizationEnforcementRequired",
            "protectedLayoutBeforeValidationForbidden",
            "singleFlight",
            "states",
            "authenticationStateUpdatedBeforeMainLayout",
            "staleSessionClearedOnInvalid"
