                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "defaultPolicy",
                    "allowedTargets",
                    "allowedUserSelect",
                    "outsideAllowedTargetsUserSelect",
                    "touchCalloutOutsideAllowedTargetsForbidden",
                    "caretAndClipboardPreservedForAllowedTargets"
