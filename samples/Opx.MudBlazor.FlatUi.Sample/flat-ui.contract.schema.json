          "properties": {
            "outerMarginPx": { "const": 0 },
            "gridGapPx": {
              "type": "object",
              "additionalProperties": false,
              "required": ["desktop", "mobile"],
              "properties": {
                "desktop": { "const": 12 },
                "mobile": { "const": 10 }
              }
            },
            "bodyPaddingPx": { "const": 12 },
            "headerPaddingPx": {
              "type": "object",
              "additionalProperties": false,
              "required": ["block", "inline"],
              "properties": {
                "block": { "const": 9 },
                "inline": { "const": 12 }
              }
            },
            "footerPaddingPx": {
              "type": "object",
              "additionalProperties": false,
              "required": ["block", "inline"],
              "properties": {
                "block": { "const": 8 },
                "inline": { "const": 12 }
              }
            },
            "sectionGapPx": {
              "type": "object",
              "additionalProperties": false,
              "required": ["desktop", "mobile"],
              "properties": {
                "desktop": { "const": 18 },
                "mobile": { "const": 16 }
              }
            },
            "sectionHeadingBottomMarginPx": { "const": 8 },
            "actionMetricPaddingPx": {
              "type": "object",
              "additionalProperties": false,
              "required": ["desktop", "mobile"],
              "properties": {
                "desktop": { "const": 13 },
                "mobile": { "const": 12 }
              }
            },
            "compactMetricPaddingPx": { "const": 13 },
            "lowerGridTopMarginPx": {
              "type": "object",
              "additionalProperties": false,
              "required": ["desktop", "mobile"],
              "properties": {
                "desktop": { "const": 12 },
                "mobile": { "const": 10 }
              }
            },
            "mobileBreakpointPx": { "const": 600 }
          }
        },
        "allowedAdaptations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["branding", "wording", "data", "authorization", "domain-integration"]
          }
        }
      }
    }
  }
}
