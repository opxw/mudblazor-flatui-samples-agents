          "properties": {
            "desktopTableAbovePx": { "const": 900 },
            "responsiveCardMaxPx": { "const": 900 },
            "twoColumnCardMinPx": { "const": 601 },
            "twoColumnCardMaxPx": { "const": 900 },
            "phoneSingleColumnMaxPx": { "const": 600 },
            "bottomNavigationDefaultMaxWidthPx": { "const": 600 },
            "bottomNavigationSampleMaxWidthPx": { "const": 900 },
            "bottomNavigationViewportOnly": { "const": true },
            "bottomNavigationBarHeightPx": { "const": 60 },
            "bottomNavigationLabelLineHeight": { "const": 1.25 },
            "bottomNavigationLabelBottomInsetPx": { "const": 1 },
            "bottomNavigationDescendersVisible": { "const": true },
            "liveResizeRequired": { "const": true },
            "platformUserAgentLayoutForbidden": { "const": true }
          }
        },
        "nativeMobileDeployment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "appliesWhen",
            "platforms",
            "toolkitPackage",
            "builderRegistration",
            "typography",
            "statusBar",
            "startupLoading",
            "webViewInteraction"
