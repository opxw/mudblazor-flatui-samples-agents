@page "/profile-grid"
@inject ISnackbar Snackbar
@inject FlatMessageBoxService MessageBox

@* Copyright (c) 2026 opx. All rights reserved. *@

<PageTitle>Profile Card Grid - Opx MudBlazor Flat UI</PageTitle>

<FlatPage Kind="FlatPageKind.Module"
          UsePanel="false"
          PageCssClass="profile-grid-page"
          ShowMobilePrimaryAction="true">
    <MobilePrimaryAction>
        <FlatFab Icon="@Icons.Material.Outlined.PersonAdd" Label="Add member" OnClick="OpenAddMember" />
    </MobilePrimaryAction>
    <ChildContent>
        <FlatCardGrid TItem="MemberCard"
                      Items="@FilteredMembers"
                      SearchText="@_search"
                      SearchTextChanged="SearchChanged"
                      SearchPlaceholder="Search for name or designation..."
                      View="@_view"
                      ViewChanged="ViewChanged"
                      AddText="Add member"
                      OnAdd="OpenAddMember"
                      ShowOverflow="false"
                      EmptyTitle="No members found"
                      EmptyMessage="Try another name or designation."
                      AriaLabel="Member profile grid">
            <SearchTrailingActions>
                <MudIconButton Icon="@Icons.Material.Outlined.FilterAlt"
                               Class="grid-action-button"
                               OnClick="ShowFilter"
                               aria-label="Filter members"
                               title="Filter members" />
            </SearchTrailingActions>
            <ItemTemplate Context="member">
                @if (_view == FlatCardGridView.List)
                {
                    <FlatProfileListItem Name="@member.Name"
                                         Identifier="@member.Identifier"
                                         Subtitle="@member.Role"
                                         MetaText="@member.Department"
                                         Initials="@member.Initials"
                                         ImageUrl="@member.ImageUrl"
                                         OnClick="@(() => OpenProfile(member))">
                        <Badges>
                            <FlatStatusChip Text="@member.Category" Color="Color.Secondary" />
                            <FlatStatusChip Text="@member.Access" Color="Color.Success" />
                        </Badges>
                    </FlatProfileListItem>
                }
                else
                {
                    <FlatProfileCard Name="@member.Name"
                                     Subtitle="@member.Role"
                                     Initials="@member.Initials"
                                     ImageUrl="@member.ImageUrl"
                                     CoverTone="@member.CoverTone"
                                     Favorite="@member.Favorite"
                                     Stats="@member.Stats"
                                     OnFavorite="@(() => ToggleFavorite(member))"
                                     OnMore="@(() => Snackbar.Add($"Actions for {member.Name} are host-defined.", Severity.Info))"
                                     OnView="@(() => OpenProfile(member))" />
                }
            </ItemTemplate>
        </FlatCardGrid>
    </ChildContent>
</FlatPage>

<FlatFormModal @bind-Open="_addOpen"
               Title="Add member"
               Mode="Create"
               Size="@FlatFormModalSize.Small"
               CanSubmit="@CanAdd"
               IsDirty="@IsAddDirty"
               ConfirmClose="ConfirmDiscardAsync"
               OnSubmit="AddMemberAsync">
    <MudTextField T="string" @bind-Value="_newName" Immediate="true" Label="Name" Variant="@FlatPreferences.InputVariant" Margin="Margin.Dense" Required="true" />
    <MudTextField T="string" @bind-Value="_newRole" Immediate="true" Label="Designation" Variant="@FlatPreferences.InputVariant" Margin="Margin.Dense" Required="true" />
    <MudTextField T="string" @bind-Value="_newInitials" Immediate="true" Label="Initials (optional)" Variant="@FlatPreferences.InputVariant" Margin="Margin.Dense" />
</FlatFormModal>

@code {
    private readonly List<MemberCard> _members =
    [
        new("Nancy Martino", "EMP-2026-001", "Team Leader", "Human Resources", "People", "Lead", "NM", "/sample-profile.svg", "cover-primary", 225, 197, true),
        new("Henry Baird", "EMP-2026-002", "Staff", "Information Technology", "Platform", "Staff", "HB", null, "cover-info", 352, 376, false),
        new("Frank Hook", "EMP-2026-003", "Supervisor", "Operations", "Field", "Supervisor", "FH", null, "cover-success", 164, 182, true),
        new("Jennifer Carter", "EMP-2026-004", "Staff", "Product Design", "Creative", "Staff", "JC", "/sample-profile.svg", "cover-secondary", 241, 204, true),
        new("Megan Elmore", "EMP-2026-005", "Team Leader", "Engineering", "Web", "Lead", "ME", null, "cover-warning", 201, 263, false),
        new("Alexis Clarke", "EMP-2026-006", "Staff", "Engineering", "Backend", "Staff", "AC", null, "cover-success", 132, 147, false),
        new("Nathan Cole", "EMP-2026-007", "Staff", "Engineering", "Frontend", "Staff", "NC", null, "cover-primary", 352, 376, true),
        new("Joseph Parker", "EMP-2026-008", "Staff", "Information Technology", "Support", "Staff", "JP", null, "cover-info", 64, 93, true)
    ];

    private string _search = "";
    private string _view = FlatCardGridView.List;
    private bool _addOpen;
    private string _newName = "";
    private string _newRole = "";
    private string _newInitials = "";

    private IReadOnlyList<MemberCard> FilteredMembers => _members
        .Where(member => string.IsNullOrWhiteSpace(_search)
            || member.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
            || member.Role.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))
        .ToList();
    private bool CanAdd => !string.IsNullOrWhiteSpace(_newName) && !string.IsNullOrWhiteSpace(_newRole);
    private bool IsAddDirty => !string.IsNullOrWhiteSpace(_newName) || !string.IsNullOrWhiteSpace(_newRole) || !string.IsNullOrWhiteSpace(_newInitials);

    private void SearchChanged(string value) => _search = value ?? "";
    private void ViewChanged(string value) => _view = value;
    private void ToggleFavorite(MemberCard member) => member.Favorite = !member.Favorite;
    private void ShowFilter() => Snackbar.Add("Member filters are supplied by the host app.", Severity.Info);
    private void OpenProfile(MemberCard member) => Snackbar.Add($"Open profile: {member.Name}", Severity.Info);

    private void OpenAddMember()
    {
        _newName = "";
        _newRole = "";
        _newInitials = "";
        _addOpen = true;
    }

    private Task<bool> ConfirmDiscardAsync() => MessageBox.QuestionAsync("Discard the new member form?", title: "Close form");

    private Task AddMemberAsync()
    {
        if (!CanAdd) return Task.CompletedTask;
        var initials = string.IsNullOrWhiteSpace(_newInitials) ? null : _newInitials.Trim();
        _members.Insert(0, new(_newName.Trim(), $"EMP-2026-{_members.Count + 1:000}", _newRole.Trim(), "Unassigned", "General", "Staff", initials, null, "cover-primary", 0, 0, false));
        Snackbar.Add("Member added to sample page memory.", Severity.Success);
        return Task.CompletedTask;
    }

    private sealed class MemberCard(string name, string identifier, string role, string department, string category, string access, string? initials, string? imageUrl, string coverTone, int projects, int tasks, bool favorite)
    {
        public string Name { get; } = name;
        public string Identifier { get; } = identifier;
        public string Role { get; } = role;
        public string Department { get; } = department;
        public string Category { get; } = category;
        public string Access { get; } = access;
        public string? Initials { get; } = initials;
        public string? ImageUrl { get; } = imageUrl;
        public string CoverTone { get; } = coverTone;
        public bool Favorite { get; set; } = favorite;
        public IReadOnlyList<FlatProfileCardStat> Stats { get; } =
        [
            new("Projects", projects.ToString()),
            new("Tasks", tasks.ToString())
        ];
    }
}
