@page "/enterprise-toolkit"

<FlatPage Kind="FlatPageKind.Module" PageCssClass="enterprise-toolkit-page no-mobile-fab">
    <div class="enterprise-release-strip">
        @foreach (var release in Releases) { <span><strong>@release.Version</strong>@release.Scope</span> }
    </div>

    <section class="enterprise-sample-grid">
        <article class="flat-panel enterprise-span-2"><header><strong>Data Import Wizard</strong><small>1.2 · host-owned upload and submit</small></header><FlatDataImport Step="@_importStep" StepChanged="SetImportStep" Fields="ImportFields" Columns="_importColumns" ColumnsChanged="SetImportColumns" Rows="ImportRows" Submit="SubmitImport"><UploadContent><div class="enterprise-upload-placeholder"><MudIcon Icon="@Icons.Material.Outlined.UploadFile"/><strong>Drop a CSV or Excel file</strong><span>The sample advances without uploading a real file.</span><MudButton Variant="Variant.Outlined" OnClick="() => SetImportStep(2)">Use sample file</MudButton></div></UploadContent></FlatDataImport></article>
        <article class="flat-panel enterprise-span-2"><header><strong>Pivot Field Chooser</strong><small>1.2 · multiple values contract</small></header><FlatPivotFieldChooser Fields="_pivotFields" FieldsChanged="SetPivotFields" /></article>
        <article class="flat-panel enterprise-span-2"><header><strong>Master–Detail Workspace</strong><small>1.2 · desktop split, mobile navigation</small></header><FlatMasterDetailWorkspace TItem="EnterpriseAccount" Items="Accounts" @bind-SelectedItem="_selectedAccount"><ItemTemplate Context="account"><strong>@account.Name</strong><small>@account.Department · @account.Status</small></ItemTemplate><DetailTemplate Context="account"><h3>@account.Name</h3><p>@account.Department · @account.Email</p><MudTabs Elevation="0"><MudTabPanel Text="Profile"><div class="enterprise-facts"><FlatInfoItem Label="Employee ID" Value="@account.Id"/><FlatInfoItem Label="Department" Value="@account.Department"/><FlatInfoItem Label="Status" Value="@account.Status"/><FlatInfoItem Label="Email" Value="@account.Email"/></div></MudTabPanel><MudTabPanel Text="Audit"><FlatAuditTrail Events="AuditEvents" /></MudTabPanel></MudTabs></DetailTemplate><EmptyDetail><div class="enterprise-empty">Select an account to view details.</div></EmptyDetail></FlatMasterDetailWorkspace></article>
        <article class="flat-panel enterprise-span-2"><header><strong>Audit Trail and Diff</strong><small>1.2 · sensitive values hidden by default</small></header><FlatAuditTrail Events="AuditEvents" /></article>
        <article class="flat-panel"><header><strong>Schema Form</strong><small>1.3 · metadata-driven fields</small></header><FlatSchemaForm Fields="SchemaFields" Values="_schemaValues" ValuesChanged="SetSchemaValues" Submit="SaveSchemaForm" /></article>
        <article class="flat-panel"><header><strong>Approval Workflow</strong><small>1.3 · callback-only actions</small></header><FlatWorkflowPanel Steps="WorkflowSteps" ActionSelected="HandleWorkflow" /></article>
        <article class="flat-panel"><header><strong>Bulk Actions</strong><small>1.3 · exact selected rows</small></header><div class="enterprise-bulk-demo"><div><strong>Maya Pratiwi</strong><span>Finance</span></div><div><strong>Rina Kurnia</strong><span>Human Resources</span></div><FlatBulkActionBar TItem="EnterpriseAccount" Selection="_bulkSelection" Actions="BulkActions" /></div></article>
        <article class="flat-panel enterprise-span-2"><header><strong>Scheduler</strong><small>1.4 · responsive weekly board</small></header><FlatScheduler PeriodStart="_periodStart" PeriodChanged="SetPeriod" Items="Schedule" /></article>
        <article class="flat-panel enterprise-span-2"><header><strong>Dashboard Composer</strong><small>1.4 · persisted layout contract</small></header><FlatDashboardComposer Widgets="_widgets" WidgetsChanged="SetWidgets" Reset="ResetWidgets"><WidgetTemplate Context="widget"><div class="enterprise-widget"><strong>@WidgetValue(widget.Key)</strong><span>Host-rendered content</span></div></WidgetTemplate></FlatDashboardComposer></article>
        <article class="flat-panel"><header><strong>Notification Center</strong><small>1.4 · application inbox</small></header><FlatNotificationCenter Items="_notifications" Selected="ReadNotification" MarkAllRead="MarkAllNotifications" /></article>
        <article class="flat-panel"><header><strong>Offline Sync</strong><small>1.5 · pending, error, conflict</small></header><FlatOfflineSyncPanel Items="_syncItems" Retry="RetrySync" /></article>
        <article class="flat-panel enterprise-span-2"><header><strong>Document Workspace</strong><small>1.5 · host-owned actions and preview</small></header><FlatDocumentWorkspace Documents="Documents" @bind-SelectedDocument="_selectedDocument" Actions="DocumentActions" ActionSelected="HandleDocumentAction"><PreviewTemplate Context="document"><div class="enterprise-document-preview"><MudIcon Icon="@Icons.Material.Outlined.PictureAsPdf"/><strong>@document.Name</strong><span>Replace this slot with the host PDF, image, or office viewer.</span></div></PreviewTemplate></FlatDocumentWorkspace></article>
        <article class="flat-panel enterprise-span-2"><header><strong>Print Layout</strong><small>1.5 · A4 and print media contract</small></header><div class="enterprise-print-preview"><FlatPrintLayout Title="Monthly Operations Report" Subtitle="August 2026" HeaderAddress="OPX · Jakarta"><table><thead><tr><th>Department</th><th>Tickets</th><th>SLA</th></tr></thead><tbody><tr><td>IT</td><td>28</td><td>96%</td></tr><tr><td>Finance</td><td>12</td><td>98%</td></tr></tbody></table></FlatPrintLayout></div></article>
    </section>

</FlatPage>

@code {
    private static readonly (string Version, string Scope)[] Releases = [("1.2", "Data and insight"), ("1.3", "Process automation"), ("1.4", "Workspace productivity"), ("1.5", "Enterprise operations")];
    private int _importStep = 1;
    private IReadOnlyList<FlatDataImportColumn> _importColumns = [new("Employee ID", "id"), new("Full Name", "name"), new("Email Address", "email")];
    private static readonly IReadOnlyList<FlatDataImportField> ImportFields = [new("id", "Employee ID", typeof(string), true), new("name", "Full Name", typeof(string), true), new("email", "Email", typeof(string))];
    private static readonly IReadOnlyList<FlatDataImportRow> ImportRows = [new(2, new Dictionary<string,string?>{{"id","EMP-001"},{"name","Maya"},{"email","maya@opx.local"}}, FlatDataImportRowState.Accepted, []), new(3, new Dictionary<string,string?>{{"id",""},{"name","Rina"},{"email","rina@opx.local"}}, FlatDataImportRowState.Rejected, [new("id","Employee ID is required")])];
    private IReadOnlyList<FlatPivotFieldDefinition> _pivotFields = [new("department","Department",FlatPivotFieldArea.Rows),new("quarter","Quarter",FlatPivotFieldArea.Columns),new("revenue","Revenue",FlatPivotFieldArea.Values,true,FlatPivotAggregate.Sum),new("quantity","Quantity",FlatPivotFieldArea.Values,true,FlatPivotAggregate.Sum),new("region","Region",FlatPivotFieldArea.Available)];
    private static readonly IReadOnlyList<EnterpriseAccount> Accounts = [new("EMP-001","Maya Pratiwi","Finance","Active","maya@opx.local"),new("EMP-002","Rina Kurnia","Human Resources","Active","rina@opx.local"),new("EMP-003","Dimas Putra","IT","Review","dimas@opx.local")];
    private EnterpriseAccount? _selectedAccount = Accounts[0];
    private FlatBulkSelection<EnterpriseAccount> _bulkSelection = new(Accounts.Take(2).ToArray());
    private static readonly IReadOnlyList<FlatAuditEvent> AuditEvents = [new("AUD-2",FlatAuditAction.Approve,"Rina",DateTimeOffset.Now.AddMinutes(-24),"REQ-1208","Policy verified",[new("Status","Review","Approved")]),new("AUD-1",FlatAuditAction.Update,"Maya",DateTimeOffset.Now.AddHours(-3),"REQ-1208",null,[new("Department","Operations","Finance"),new("Salary","10","12",true)])];
    private static readonly IReadOnlyList<FlatFormFieldDefinition> SchemaFields = [new("name","Name",FlatFormFieldKind.Text,true,"Enter name"),new("department","Department",FlatFormFieldKind.Select,true,"Select department",["Finance","HR","IT"]),new("active","Active",FlatFormFieldKind.Checkbox),new("notes","Notes",FlatFormFieldKind.MultilineText,false,"Optional notes")];
    private IReadOnlyDictionary<string,object?> _schemaValues = new Dictionary<string,object?>{{"department","IT"},{"active",true}};
    private static readonly IReadOnlyList<FlatWorkflowStep> WorkflowSteps = [new("draft","Request created","Complete","Maya",DateTimeOffset.Now.AddHours(-4)),new("manager","Manager review","Pending","Rina"),new("finance","Finance approval","Waiting")];
    private DateTimeOffset _periodStart = new(DateTime.Today);
    private static readonly DateTimeOffset Today = new(DateTime.Today);
    private static readonly IReadOnlyList<FlatSchedulerItem> Schedule = [new("EV-1","Production planning",Today.AddHours(9),Today.AddHours(10),"Plant A"),new("EV-2","Payroll review",Today.AddDays(2).AddHours(13),Today.AddDays(2).AddHours(14),"Finance")];
    private static readonly FlatDashboardWidgetDefinition[] DefaultWidgets = [new("revenue","Revenue",0,2),new("orders","Orders",1),new("sla","SLA",2),new("trend","Trend",3,2)];
    private IReadOnlyList<FlatDashboardWidgetDefinition> _widgets = DefaultWidgets;
    private IReadOnlyList<FlatNotificationItem> _notifications = [new("N-1","Approval required","Purchase request PR-102 needs review.",DateTimeOffset.Now.AddMinutes(-8)),new("N-2","Import complete","48 rows were accepted.",DateTimeOffset.Now.AddHours(-1),true)];
    private IReadOnlyList<FlatSyncItem> _syncItems = [new("S-1","Attendance draft",FlatSyncItemState.Pending,DateTimeOffset.Now.AddMinutes(-2),"Waiting for connection"),new("S-2","Stock count",FlatSyncItemState.Conflict,DateTimeOffset.Now.AddMinutes(-9),"Server value changed"),new("S-3","Inspection photo",FlatSyncItemState.Completed,DateTimeOffset.Now.AddMinutes(-15))];
    private static readonly IReadOnlyList<FlatDocumentItem> Documents = [new("D-1","Purchase order.pdf","application/pdf",248_832,null,"v3"),new("D-2","Inspection.jpg","image/jpeg",1_842_000,null,"v1")];
    private FlatDocumentItem? _selectedDocument = Documents[0];
    private static readonly IReadOnlyList<FlatDocumentWorkspaceAction> DocumentActions = [new("download","Download",Icons.Material.Outlined.Download),new("version","Versions",Icons.Material.Outlined.History)];
    private static readonly IReadOnlyList<FlatBulkAction<EnterpriseAccount>> BulkActions = [new("export","Export",Icons.Material.Outlined.Download,(_,_)=>Task.CompletedTask),new("disable","Disable",Icons.Material.Outlined.Block,(_,_)=>Task.CompletedTask,true)];
    private Task SetImportStep(int step){_importStep=step;return Task.CompletedTask;} private Task SetImportColumns(IReadOnlyList<FlatDataImportColumn> columns){_importColumns=columns;return Task.CompletedTask;} private Task SubmitImport(FlatDataImportSubmission submission){_importStep=4;return Task.CompletedTask;} private Task SetPivotFields(IReadOnlyList<FlatPivotFieldDefinition> fields){_pivotFields=fields;return Task.CompletedTask;} private Task SetSchemaValues(IReadOnlyDictionary<string,object?> values){_schemaValues=values;return Task.CompletedTask;} private Task SaveSchemaForm(FlatFormSubmission _)=>Task.CompletedTask; private Task HandleWorkflow(FlatWorkflowActionRequest _)=>Task.CompletedTask; private Task SetPeriod(DateTimeOffset period){_periodStart=period;return Task.CompletedTask;} private Task SetWidgets(IReadOnlyList<FlatDashboardWidgetDefinition> widgets){_widgets=widgets;return Task.CompletedTask;} private Task ResetWidgets(){_widgets=DefaultWidgets;return Task.CompletedTask;} private string WidgetValue(string key)=>key switch{"revenue"=>"$128K","orders"=>"842","sla"=>"97.4%",_=>"+12.8%"};
    private Task ReadNotification(FlatNotificationItem item){_notifications=_notifications.Select(x=>x.Key==item.Key?x with{Read=true}:x).ToArray();return Task.CompletedTask;} private Task MarkAllNotifications(){_notifications=_notifications.Select(x=>x with{Read=true}).ToArray();return Task.CompletedTask;} private Task RetrySync(FlatSyncRetryRequest request){_syncItems=_syncItems.Select(x=>request.Keys.Contains(x.Key)?x with{State=FlatSyncItemState.Syncing,Message="Retrying"}:x).ToArray();return Task.CompletedTask;} private Task HandleDocumentAction(FlatDocumentActionRequest _)=>Task.CompletedTask;
    private sealed record EnterpriseAccount(string Id,string Name,string Department,string Status,string Email);
}
