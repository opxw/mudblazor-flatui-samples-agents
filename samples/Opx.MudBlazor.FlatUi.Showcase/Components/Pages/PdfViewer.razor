@page "/pdf-viewer"
@inject FlatMessageBoxService MessageBox
@inject FlatPageLoadingState PageLoading
@inject IFlatPrintService PrintService

<FlatPage Kind="FlatPageKind.Detail" PageCssClass="pdf-viewer-page no-mobile-fab">
    <FlatPdfViewer SourceUrl="@_pdfUrl"
                   Title="Sales Report"
                   Subtitle="August 2026"
                   Busy="@_busy"
                   OnBack="BackAsync"
                   OnRefresh="RefreshAsync"
                   OnDownload="DownloadAsync"
                   OnShare="ShareAsync"
                   OnOpenExternal="OpenExternalAsync"
                   OnPrint="PrintAsync"
                   StateChanged="StateChangedAsync">
        <ParametersContent>
            <MudSelect T="string" @bind-Value="_period" Label="Period" Variant="@FlatPreferences.InputVariant" Margin="Margin.Dense">
                <MudSelectItem Value="@("August 2026")">August 2026</MudSelectItem>
                <MudSelectItem Value="@("July 2026")">July 2026</MudSelectItem>
            </MudSelect>
            <MudSelect T="string" @bind-Value="_branch" Label="Branch" Variant="@FlatPreferences.InputVariant" Margin="Margin.Dense">
                <MudSelectItem Value="@("All branches")">All branches</MudSelectItem>
                <MudSelectItem Value="@("Jakarta")">Jakarta</MudSelectItem>
                <MudSelectItem Value="@("Surabaya")">Surabaya</MudSelectItem>
            </MudSelect>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RefreshAsync" Disabled="@_busy">Apply</MudButton>
        </ParametersContent>
    </FlatPdfViewer>
</FlatPage>

@code {
    private readonly byte[] _pdfBytes = Opx.MudBlazor.FlatUi.Showcase.SamplePdfDocument.Create();
    private string _pdfUrl = string.Empty;
    protected override void OnInitialized() => _pdfUrl = "data:application/pdf;base64," + Convert.ToBase64String(_pdfBytes);

    private async Task PrintAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var capability = await PrintService.GetCapabilitiesAsync();
            var result = capability.CanPrintPdf
                ? await PrintService.PrintAsync(new FlatPrintRequest(_pdfBytes, "Sales Report"))
                : new FlatPrintResult(FlatPrintStatus.Unsupported);
            await MessageBox.InfoAsync(result.Status == FlatPrintStatus.Submitted
                ? "Print dialog requested. This host cannot confirm physical printing or the final outcome."
                : $"Print result: {result.Status}", "PDF printing");
        }
        finally { _busy = false; }
    }
    private string _period = "August 2026";
    private string _branch = "All branches";
    private bool _busy;
    private FlatPdfViewerState? _state;

    private Task BackAsync() => MessageBox.InfoAsync("The Back callback is host-owned. A MAUI host can close the document workspace or navigate to its report list.", "Back requested");

    private async Task RefreshAsync()
    {
        if (_busy) return;
        _busy = true;
        using var loading = PageLoading.Begin();
        await InvokeAsync(StateHasChanged);
        await Task.Delay(350);
        _busy = false;
        await MessageBox.InfoAsync($"Refresh requested for {_period}, {_branch}. The host owns report generation and source replacement.", "Report refreshed");
    }

    private Task DownloadAsync() => MessageBox.InfoAsync("Download is an exact host callback. The host owns authorization, file access, and storage.", "Download requested");
    private Task ShareAsync() => MessageBox.InfoAsync("A MAUI host can handle this callback with Share.Default.RequestAsync.", "Share requested");
    private Task OpenExternalAsync() => MessageBox.InfoAsync("A MAUI host can handle this callback with Launcher.Default.OpenAsync.", "Open externally");
    private Task StateChangedAsync(FlatPdfViewerState state) { _state = state; return Task.CompletedTask; }
}
