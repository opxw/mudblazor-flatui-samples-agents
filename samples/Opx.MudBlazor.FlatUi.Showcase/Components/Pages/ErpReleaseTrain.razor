@page "/erp-release-train"
<FlatPage Kind="FlatPageKind.Module" PageCssClass="erp-release-page no-mobile-fab"><section class="erp-release-grid">
<article class="flat-panel erp-release-span-2"><header><strong>2.1 · Transaction Engine</strong><small>Lifecycle commands, version context, and validation</small></header><FlatTransactionEngine THeader="DemoOrder" TLine="DemoLine" Header="Order" Lines="Lines" Context="TransactionContext" ValidationIssues="Issues" CommandSelected="Remember" LineAction="HandleTransactionLine"><HeaderTemplate Context="x"><strong>@x.Reference</strong><small>@x.Customer</small></HeaderTemplate><LineTemplate Context="x"><span><b>@x.Item</b><small>@x.Quantity.ToString("N2") × @x.Price.ToString("N0")</small></span></LineTemplate><SummaryTemplate Context="x"><FlatNumberText Value="@Lines.Sum(y=>y.Quantity*y.Price)" Format="#,##0" Currency="true"/></SummaryTemplate></FlatTransactionEngine></article>
<article class="flat-panel"><header><strong>2.2 · Inventory Allocation</strong><small>Warehouse, bin, lot/serial, expiry, and reservation</small></header><FlatInventoryAllocationWorkspace Items="Allocations" ActionSelected="Remember"/></article>
<article class="flat-panel"><header><strong>2.3 · Finance</strong><small>Journal balance and localized monetary values</small></header><FlatJournalEntryGrid TLine="JournalLine" Lines="Journal" AccountText="x=>x.Account" DescriptionText="x=>x.Description" Debit="x=>x.Debit" Credit="x=>x.Credit" Currency="IDR"/></article>
<article class="flat-panel"><header><strong>2.4 · Workflow Designer</strong><small>Sequential, parallel, and conditional stage intents</small></header><FlatWorkflowDesigner Nodes="Workflow" Changed="Remember"/></article>
<article class="flat-panel"><header><strong>2.4 · Approval Inbox</strong><small>Bulk intent; authorization remains host-owned</small></header><FlatApprovalInbox Items="Inbox" ActionSelected="Remember"/></article>
<article class="flat-panel"><header><strong>2.5 · Integration Center</strong><small>Correlation, retry, and dead-letter presentation</small></header><FlatIntegrationCenter Runs="IntegrationRuns" ActionSelected="Remember"/></article>
<article class="flat-panel erp-release-span-2"><header><strong>3.0 · MRP and Capacity</strong><small>Material shortage and work-center load</small></header><FlatMrpCapacityWorkspace Requirements="Requirements" Capacity="Capacity" ActionSelected="Remember"/></article>
<article class="flat-panel erp-release-span-2"><header><strong>3.0 · Governance</strong><small>SoD, period lock, field policy, and sensitive audit checks</small></header><FlatGovernancePanel Checks="Governance" ActionSelected="Remember"/></article>
</section></FlatPage>
@code {
 private Task Remember<T>(T value)=>Task.CompletedTask;
 private sealed record DemoOrder(string Reference,string Customer); private sealed class DemoLine(string key,string item,decimal quantity,decimal price){public string Key{get;set;}=key;public string Item{get;set;}=item;public decimal Quantity{get;set;}=quantity;public decimal Price{get;set;}=price;} private sealed record JournalLine(string Account,string Description,decimal Debit,decimal Credit);
 private DemoOrder Order=new("SO-260819","PT Nusantara"); private List<DemoLine> Lines=[new("1","Industrial scanner",2,4_250_000),new("2","Support subscription",1,950_000)];
 private FlatTransactionContext TransactionContext=new("SO-260819","v4","demo-idempotency",["QT-260110"]); private IReadOnlyList<FlatValidationIssue> Issues=[new("credit","Credit review is required before submission.")];
 private IReadOnlyList<FlatInventoryAllocation> Allocations=[new("a1","SCAN-01","MAIN","A-01","LOT-2608",12,2,"EA",FlatInventoryAllocationState.Available,new DateOnly(2027,8,1)),new("a2","SCAN-01","MAIN","A-02","SN-10882",1,1,"EA",FlatInventoryAllocationState.Allocated)];
 private IReadOnlyList<JournalLine> Journal=[new("110100","Inventory",9_450_000,0),new("210100","Payable",0,9_450_000)];
 private IReadOnlyList<FlatWorkflowNode> Workflow=[new("s","Start",FlatWorkflowNodeKind.Start,1),new("m","Manager approval",FlatWorkflowNodeKind.Approval,2),new("c","Amount threshold",FlatWorkflowNodeKind.Condition,3,"Total > 10M"),new("e","Post document",FlatWorkflowNodeKind.End,4)];
 private IReadOnlyList<FlatApprovalInboxItem> Inbox=[new("i1","Purchase request","PR-26088","Rina","Pending",DateTimeOffset.Now.AddHours(-2)),new("i2","Journal posting","JE-26041","Dimas","Review",DateTimeOffset.Now.AddHours(-1))];
 private IReadOnlyList<FlatIntegrationRun> IntegrationRuns=[new("r1","Sales order outbound","Outbound",FlatIntegrationRunState.Completed,100,DateTimeOffset.Now,"COR-1001"),new("r2","Supplier invoice import","Inbound",FlatIntegrationRunState.DeadLetter,72,DateTimeOffset.Now,"COR-1002","3 rejected rows")];
 private IReadOnlyList<FlatMaterialRequirement> Requirements=[new("m1","RM-STEEL",120,80,40,"KG",DateOnly.FromDateTime(DateTime.Today.AddDays(3))),new("m2","RM-SENSOR",25,10,15,"EA",DateOnly.FromDateTime(DateTime.Today.AddDays(5)))];
 private IReadOnlyList<FlatCapacityBucket> Capacity=[new("c1","Assembly Line A",DateOnly.FromDateTime(DateTime.Today),8,7.2m,"HR"),new("c2","Quality Station",DateOnly.FromDateTime(DateTime.Today),8,9.5m,"HR")];
 private IReadOnlyList<FlatGovernanceCheck> Governance=[new("g1","Segregation of duties","Access",FlatGovernanceState.Warning,"Requester is also backup approver."),new("g2","Posting period","Finance",FlatGovernanceState.Pass,"Current period is open."),new("g3","Sensitive field policy","Security",FlatGovernanceState.Blocked,"Bank account requires elevated permission.",true)];
 private DemoLine CreateLine()=>new($"N{Lines.Count+1}","New item",1,0); private Task HandleTransactionLine(FlatTransactionLineActionRequest<DemoLine> request){if(request.Action==FlatTransactionLineActionKind.Add){Lines.Add(CreateLine());Lines=[..Lines];}else if(request.Action==FlatTransactionLineActionKind.Delete&&request.Line is not null){Lines.RemoveAll(x=>x.Key==request.Line.Key);Lines=[..Lines];}return Task.CompletedTask;}
}
