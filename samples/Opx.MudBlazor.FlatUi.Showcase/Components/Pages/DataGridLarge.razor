@page "/data-grid-large"
@inject FlatGridOptions GridOptions
@inject FlatPageLoadingState PageLoading
@inject FlatValueFormatter ValueFormatter

<FlatPage Kind="FlatPageKind.Module"
          PageCssClass="large-data-grid-page"
          InitialLoading="@_initialLoading"
          SkeletonColumnCount="12"
          SkeletonRowCount="9"
          SkeletonMobileRowCount="6"
          SkeletonMobileFieldCount="6"
          SkeletonLoadingText="Loading order data"
          ReadOnlySource="In-memory sample data"
          FilterEnabled="@Columns.Any(column => column.FilterEnabled)"
          FilterActive="@GridState.HasActiveFilters"
          OnFilter="() => _filterOpen = true"
          RefreshEnabled="true"
          RefreshDisabled="@_initialLoading"
          OnRefresh="RefreshPageAsync">
    <ToolbarContent>
        <MudTextField T="string"
                      Value="_search"
                      ValueChanged="SearchChanged"
                      Placeholder="Search orders, customers, or references..."
                      Variant="@FlatPreferences.InputVariant"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Outlined.Search"
                      Class="module-search" />
    </ToolbarContent>
    <ToolbarActions>
        <MudIconButton Icon="@Icons.Material.Outlined.HourglassTop"
                       Disabled="@_initialLoading"
                       OnClick="PreviewInitialLoadAsync"
                       Class="grid-action-button"
                       aria-label="Preview initial skeleton loading"
                       title="Preview initial skeleton loading" />
        <MudIconButton Icon="@(_headerStyle == FlatGridHeaderStyle.CompactSearch ? Icons.Material.Outlined.ViewHeadline : Icons.Material.Outlined.ManageSearch)"
                       Disabled="@_initialLoading"
                       OnClick="ToggleHeaderStyle"
                       Class="grid-action-button"
                       aria-label="@(_headerStyle == FlatGridHeaderStyle.CompactSearch ? "Use standard grid headers" : "Use compact searchable grid headers")"
                       title="@(_headerStyle == FlatGridHeaderStyle.CompactSearch ? "Standard headers" : "Compact searchable headers")" />
        <MudIconButton Icon="@(_showHeaderIcons ? Icons.Material.Outlined.VisibilityOff : Icons.Material.Outlined.Visibility)"
                       Disabled="@(_initialLoading || _headerStyle != FlatGridHeaderStyle.CompactSearch)"
                       OnClick="() => _showHeaderIcons = !_showHeaderIcons"
                       Class="grid-action-button"
                       aria-label="@(_showHeaderIcons ? "Hide grid header icons" : "Show grid header icons")"
                       title="@(_showHeaderIcons ? "Hide header icons" : "Show header icons")" />
        <MudIconButton Icon="@Icons.Material.Outlined.WrapText"
                       Disabled="@_initialLoading"
                       Color="@(_autoRowHeight ? Color.Primary : Color.Default)"
                       OnClick="() => _autoRowHeight = !_autoRowHeight"
                       Class="grid-action-button"
                       aria-pressed="@_autoRowHeight"
                       aria-label="@(_autoRowHeight ? "Disable automatic row height" : "Enable automatic row height")"
                       title="@(_autoRowHeight ? "Fixed row height" : "Automatic row height")" />
        <MudIconButton Icon="@Icons.Material.Outlined.TableRows"
                       Disabled="@_initialLoading"
                       Color="@(_alternatingRows ? Color.Primary : Color.Default)"
                       OnClick="() => _alternatingRows = !_alternatingRows"
                       Class="grid-action-button"
                       aria-pressed="@_alternatingRows"
                       aria-label="@(_alternatingRows ? "Disable alternating rows" : "Enable alternating rows")"
                       title="@(_alternatingRows ? "Plain rows" : "Alternating rows")" />
        <MudIconButton Icon="@Icons.Material.Outlined.BorderVertical"
                       Disabled="@_initialLoading"
                       Color="@(_showVerticalLines ? Color.Primary : Color.Default)"
                       OnClick="() => _showVerticalLines = !_showVerticalLines"
                       Class="grid-action-button"
                       aria-pressed="@_showVerticalLines"
                       aria-label="@(_showVerticalLines ? "Hide vertical grid lines" : "Show vertical grid lines")"
                       title="@(_showVerticalLines ? "Hide vertical lines" : "Show vertical lines")" />
        <MudIconButton Icon="@Icons.Material.Outlined.BorderHorizontal"
                       Disabled="@_initialLoading"
                       Color="@(_showHorizontalLines ? Color.Primary : Color.Default)"
                       OnClick="() => _showHorizontalLines = !_showHorizontalLines"
                       Class="grid-action-button"
                       aria-pressed="@_showHorizontalLines"
                       aria-label="@(_showHorizontalLines ? "Hide horizontal grid lines" : "Show horizontal grid lines")"
                       title="@(_showHorizontalLines ? "Hide horizontal lines" : "Show horizontal lines")" />
    </ToolbarActions>
    <ChildContent>
        <div class="large-grid-host">
                <FlatDataGrid TItem="LargeGridRecord"
                              State="GridState"
                              Columns="Columns"
                              Items="PagedRecords"
                              HeaderStyle="_headerStyle"
                              ShowHeaderIcons="_showHeaderIcons"
                              AlternatingRows="_alternatingRows"
                              ShowVerticalLines="_showVerticalLines"
                              ShowHorizontalLines="_showHorizontalLines"
                              AutoRowHeight="_autoRowHeight"
                              ExportVisible="true"
                              ExcelFileName="sales-order-view.xlsx"
                              ExcelSheetName="Sales orders"
                              ValueSelector="GridValue"
                              Changed="ReloadPage"
                              AriaLabel="Large data grid with vertical and horizontal scrolling">
                    <CellTemplate Context="cell">
                        @if (cell.Column.Key == "order")
                        {
                            <div class="primary-cell"><strong>@cell.Item.OrderNumber</strong><small>@cell.Item.Reference</small></div>
                        }
                        else if (cell.Column.Key == "status")
                        {
                            <FlatStatusChip Text="@cell.FormattedValue" Color="@StatusColor(cell.Item.Status)" />
                        }
                        else
                        {
                            @cell.FormattedValue
                        }
                    </CellTemplate>
                    <EmptyContent>
                        <FlatEmptyState CssClass="empty-state compact" Title="No orders found" Message="Change the search or filter criteria." />
                    </EmptyContent>
                </FlatDataGrid>
        </div>

            <FlatMobileGrid TItem="LargeGridRecord" Items="PagedRecords">
                <CardTemplate Context="record">
                    <article class="mobile-card mobile-card-edge-tag">
                        <header>
                            <div><strong>@record.OrderNumber</strong><small>@record.Customer · @record.Reference</small></div>
                            <FlatStatusChip Text="@record.Status" Color="@StatusColor(record.Status)" />
                        </header>
                        <div class="mobile-card-body">
                            <FlatInfoItem Label="Region" Value="@record.Region" />
                            <FlatInfoItem Label="Channel" Value="@record.Channel" />
                            <FlatInfoItem Label="Sales rep" Value="@record.SalesRepresentative" />
                            <FlatInfoItem Label="Warehouse" Value="@record.Warehouse" />
                            <FlatInfoItem Label="Quantity" Value="@ValueFormatter.FormatValue(record.Quantity)" />
                            <FlatInfoItem Label="Total" Value="@ValueFormatter.FormatValue(record.Total, "N0", currency: true)" />
                        </div>
                    </article>
                </CardTemplate>
                <EmptyContent><FlatEmptyState CssClass="empty-state compact" Title="No orders found" /></EmptyContent>
            </FlatMobileGrid>

        <FlatPager State="GridState" PageSizes="LargePageSizes" Changed="ReloadPage" />
    </ChildContent>
</FlatPage>

<MobileGridFilterSheet Open="_filterOpen"
                       OpenChanged="value => _filterOpen = value"
                       Columns="Columns"
                       State="GridState"
                       OnApplied="ReloadPage" />

@code {
    private static readonly string[] Customers = ["Northwind Retail Indonesia", "Contoso Distribution", "Adventure Works Commerce", "Fabrikam Manufacturing", "Wide World Importers"];
    private static readonly string[] Channels = ["Direct", "Marketplace", "Partner", "Web Store"];
    private static readonly string[] Regions = ["Jakarta", "West Java", "Central Java", "East Java", "Bali"];
    private static readonly string[] Representatives = ["Amelia Putri", "Bima Santoso", "Citra Lestari", "Danu Prabowo", "Elisa Wijaya"];
    private static readonly string[] Statuses = ["Processing", "Ready", "Shipped", "On Hold"];
    private static readonly string[] Warehouses = ["Jakarta Main Warehouse", "Bandung Distribution Center", "Surabaya Fulfillment Hub"];
    private static readonly IReadOnlyList<int> LargePageSizes = [25, 50, 100];
    private static readonly IReadOnlyList<LargeGridRecord> Records = Enumerable.Range(1, 120)
        .Select(index => new LargeGridRecord(
            $"SO-2026-{index:0000}",
            $"REF-CUSTOMER-{10000 + index}",
            Customers[(index - 1) % Customers.Length],
            Channels[(index - 1) % Channels.Length],
            Regions[(index - 1) % Regions.Length],
            Representatives[(index - 1) % Representatives.Length],
            new DateOnly(2026, 8, 1).AddDays((index - 1) % 28),
            Statuses[(index - 1) % Statuses.Length],
            Warehouses[(index - 1) % Warehouses.Length],
            2 + index % 11,
            12 + index % 85,
            1_250_000m + index * 137_500m,
            $"Business District Block {(char)('A' + index % 6)} No. {10 + index}, {Regions[(index - 1) % Regions.Length]}"))
        .ToArray();

    private GridViewState GridState = default!;
    private IReadOnlyList<LargeGridRecord> PagedRecords = [];
    private string _search = string.Empty;
    private bool _filterOpen;
    private bool _initialLoading = true;
    private FlatGridHeaderStyle _headerStyle;
    private bool _showHeaderIcons;
    private bool _autoRowHeight = true;
    private bool _alternatingRows;
    private bool _showVerticalLines = true;
    private bool _showHorizontalLines = true;

    private static readonly IReadOnlyList<GridColumnDefinition> Columns =
    [
        new("order", "Order", WidthPercent: 9) { HeaderIcon = Icons.Material.Outlined.ReceiptLong, SearchPlaceholder = "Search order" },
        new("customer", "Customer", WidthPercent: 12) { HeaderIcon = Icons.Material.Outlined.Business, SearchPlaceholder = "Search customer" },
        new("channel", "Channel", GridColumnFilterType.Category, true, GridFilterOptions.FromValues(Channels), WidthPercent: 7) { HeaderIcon = Icons.Material.Outlined.Storefront },
        new("region", "Region", GridColumnFilterType.Category, true, GridFilterOptions.FromValues(Regions), WidthPercent: 7) { HeaderIcon = Icons.Material.Outlined.Place },
        new("representative", "Sales Representative", WidthPercent: 10) { HeaderIcon = Icons.Material.Outlined.PersonSearch },
        new("date", "Order Date", GridColumnFilterType.Date, WidthPercent: 7, ValueKind: FlatGridColumnValueKind.Date) { HeaderIcon = Icons.Material.Outlined.Event },
        new("status", "Status", GridColumnFilterType.Category, true, GridFilterOptions.FromValues(Statuses), WidthPercent: 7) { HeaderIcon = Icons.Material.Outlined.Flag },
        new("warehouse", "Warehouse", GridColumnFilterType.Category, true, GridFilterOptions.FromValues(Warehouses), WidthPercent: 10) { HeaderIcon = Icons.Material.Outlined.Warehouse },
        new("sku", "SKU Count", GridColumnFilterType.Number, WidthPercent: 5, ValueKind: FlatGridColumnValueKind.Number) { HeaderIcon = Icons.Material.Outlined.Inventory2 },
        new("quantity", "Quantity", GridColumnFilterType.Number, WidthPercent: 5, ValueKind: FlatGridColumnValueKind.Number) { HeaderIcon = Icons.Material.Outlined.Numbers },
        new("total", "Order Total", GridColumnFilterType.Number, WidthPercent: 8, ValueKind: FlatGridColumnValueKind.Currency, Format: "N0") { HeaderIcon = Icons.Material.Outlined.Payments },
        new("address", "Delivery Address", WidthPercent: 13) { HeaderIcon = Icons.Material.Outlined.LocalShipping }
    ];

    protected override void OnInitialized()
    {
        _headerStyle = GridOptions.NormalizedDefaultHeaderStyle;
        _showHeaderIcons = GridOptions.ShowHeaderIcons;
        GridState = new GridViewState(GridOptions);
        GridState.SetPageSize(50);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CompleteInitialLoadAsync();
        }
    }

    private async Task PreviewInitialLoadAsync()
    {
        if (_initialLoading)
        {
            return;
        }

        _initialLoading = true;
        await InvokeAsync(StateHasChanged);
        await CompleteInitialLoadAsync();
    }

    private async Task CompleteInitialLoadAsync()
    {
        await Task.Delay(1400);
        ReloadPage();
        _initialLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshPageAsync()
    {
        using var loading = PageLoading.Begin();
        await Task.Delay(700);
        ReloadPage();
    }

    private void SearchChanged(string value)
    {
        _search = value;
        GridState.SetPage(0);
        ReloadPage();
    }

    private void ReloadPage()
    {
        var source = Records.Where(record =>
            string.IsNullOrWhiteSpace(_search)
            || record.OrderNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || record.Customer.Contains(_search, StringComparison.OrdinalIgnoreCase)
            || record.Reference.Contains(_search, StringComparison.OrdinalIgnoreCase));
        PagedRecords = GridState.ApplyPage(source, ValueFor);
    }

    private void ToggleHeaderStyle() => _headerStyle = _headerStyle == FlatGridHeaderStyle.CompactSearch
        ? FlatGridHeaderStyle.Standard
        : FlatGridHeaderStyle.CompactSearch;

    private static string? ValueFor(LargeGridRecord record, string key) => key switch
    {
        "order" => $"{record.OrderNumber} {record.Reference}",
        "customer" => record.Customer,
        "channel" => record.Channel,
        "region" => record.Region,
        "representative" => record.SalesRepresentative,
        "date" => record.OrderDate.ToString("yyyy-MM-dd"),
        "status" => record.Status,
        "warehouse" => record.Warehouse,
        "sku" => record.SkuCount.ToString(),
        "quantity" => record.Quantity.ToString(),
        "total" => record.Total.ToString(System.Globalization.CultureInfo.InvariantCulture),
        "address" => record.DeliveryAddress,
        _ => string.Empty
    };

    private static object? GridValue(LargeGridRecord record, string key) => key switch
    {
        "order" => record.OrderNumber,
        "customer" => record.Customer,
        "channel" => record.Channel,
        "region" => record.Region,
        "representative" => record.SalesRepresentative,
        "date" => record.OrderDate,
        "status" => record.Status,
        "warehouse" => record.Warehouse,
        "sku" => record.SkuCount,
        "quantity" => record.Quantity,
        "total" => record.Total,
        "address" => record.DeliveryAddress,
        _ => null
    };

    private static Color StatusColor(string status) => status switch
    {
        "Shipped" => Color.Success,
        "On Hold" => Color.Error,
        "Ready" => Color.Info,
        _ => Color.Warning
    };

    private sealed record LargeGridRecord(
        string OrderNumber,
        string Reference,
        string Customer,
        string Channel,
        string Region,
        string SalesRepresentative,
        DateOnly OrderDate,
        string Status,
        string Warehouse,
        int SkuCount,
        int Quantity,
        decimal Total,
        string DeliveryAddress);
}
