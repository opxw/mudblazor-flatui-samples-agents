{
  "OpxFlatUi": {
    "Application": {
      "AppName": "OPX Flat UI Hybrid",
      "CompanyName": "OPX",
      "Author": "Noviyanto Wibowo",
      "Copyright": "© {Year} {CompanyName}",
      "LoginBrandBackgroundColor": "#5274b9",
      "LoginBrandBackgroundImageUrl": "_content/Opx.MudBlazor.FlatUi.Showcase/sample-job-hero.svg",
      "LoginBrandPanelVisible": true,
      "LoginBrandOverlayColor": "#000000",
      "LoginBrandOverlayOpacity": 0.38,
      "LoginLayout": "Default"
    },
    "Assets": {
      "UseMinifiedJavaScript": true
    },
    "Display": {
      "AppBarSearchVisible": true,
      "PanelHeaderMinHeight": 48,
      "PanelHeaderPaddingY": 10,
      "HostKind": "MauiHybrid",
      "DefaultThemeMode": "Light",
      "DefaultDensity": "Default",
      "DefaultInputStyle": "Outlined",
      "DefaultNavigationLayout": "Bottom",
      "DefaultBottomNavigationChildPresentation": "Sheet",
      "DefaultColorPalette": "fluent-blue",
      "UseAppFontSize": false,
      "DefaultFontSizePx": 16,
      "DefaultFabShape": "Circle",
      "DefaultRoundedSizePx": 7,
      "AutoScaleHighDensityTouchButtons": true,
      "HighDensityTouchButtonHeightPx": 42,
      "HighDensityTouchFloatingLabelFontSizePx": 12.5,
      "SidebarGroupFontWeight": 400,
      "SidebarItemFontWeight": 400,
      "StorageKey": "opx.flat-ui.maui-host.display"
    },
    "Grid": {
      "DefaultPageSize": 15,
      "PageSizes": [ 10, 15, 25, 50 ],
      "DefaultHeaderStyle": "CompactSearch",
      "ShowHeaderIcons": false
    },
    "Loading": {
      "InitialSkeletonEnabled": true,
      "DefaultTemplate": "Auto"
    },
    "Localization": {
      "Culture": "en-US",
      "UiCulture": "en-US",
      "TimeZone": "Asia/Jakarta",
      "DateFormat": "dd MMM yyyy",
      "DateTimeFormat": "dd MMM yyyy HH:mm",
      "Currency": "IDR",
      "RightToLeft": false
    },
    "Reconnect": {
      "StartupTitle": "Memuat halaman",
      "StartupMessage": "Menyiapkan aplikasi...",
      "ReconnectingTitle": "Rejoining the server...",
      "ReconnectingMessage": "Please wait a moment.",
      "FailedTitle": "Connection lost",
      "FailedMessage": "Check the network, then try again.",
      "RetryText": "Try again"
    },
    "Snackbar": {
      "HideTransitionDurationMs": 1500
    },
    "DeviceNotification": {
      "SampleTitle": "OPX Flat UI Hybrid",
      "SampleMessage": "The MAUI Settings notification test is working.",
      "SampleTag": "opx-flat-ui-hybrid-sample"
    }
  }
}
