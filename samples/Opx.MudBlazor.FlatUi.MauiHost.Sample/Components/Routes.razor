@using Opx.MudBlazor.FlatUi.Showcase

<Router AppAssembly="typeof(MauiProgram).Assembly" AdditionalAssemblies="SharedAssemblies">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainLayout)">
            <NotFound />
        </LayoutView>
    </NotFound>
</Router>

@code {
    private static readonly System.Reflection.Assembly[] SharedAssemblies =
        [typeof(ShowcaseAssemblyMarker).Assembly];
}
