<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:components="clr-namespace:Opx.MudBlazor.FlatUi.Maui.Template.Components"
             x:Class="Opx.MudBlazor.FlatUi.Maui.Template.MainPage"
             BackgroundColor="{Binding AppBarColor}">
    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{Binding AppBarColor}"
                                   StatusBarStyle="{Binding StatusBarStyle}"
                                   ApplyOn="OnPageNavigatedTo" />
    </ContentPage.Behaviors>
    <BlazorWebView x:Name="BlazorView" HostPage="wwwroot/index.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type components:AppRoot}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>
</ContentPage>
